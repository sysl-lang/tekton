// Tekton, a modeller for building solid objects.
//
//     tekton                                          a window, until it is closed
//     tekton part.tekton                              with that file open; a bad one is reported, and it starts empty
//     tekton --demo                                   with one of each shape on the bed, the second selected
//     tekton --demo --shot frame.png --size 1400x900  a few frames, the last written to a PNG
//     tekton --demo --select 3 --view 0.3,0.5         which demo shape is selected; the camera's turn and tilt
//     tekton --demo --menu Edit                       with that menu of the bar open
//     tekton --holes                                a part with a hole cut in it, and a hole not yet grouped
//     tekton --demo --control /tmp/tekton.sock        driven over HTTP on that socket, in the window as usual
//     tekton --demo --control /tmp/tekton.sock --hidden   the same with no window on the screen
//     tekton --export part.stl part.tekton            no window: the file written as STL, or 3MF for `.3mf`
//     tekton --export demo.3mf --demo                 the same for the demo scene
//
// An export that fails says why in one line and exits 1: an extension that is neither `.stl` nor `.3mf`, a file
// that cannot be read, or a document with nothing solid to print.
//
// The shaders are Metal Shading Language, so a window runs on a Mac, in a shell inside the desktop session.

import sh.sysl.sdl3.{GPU_SHADERFORMAT_MSL, deliver_dialogs}
import sh.sysl.sdl3.control.{Request, Routed}
import sh.sysl.tekton.batch.export_command
import sh.sysl.tekton.interface.new_workspace
import sh.sysl.tekton.live.{routes as live_routes}
import sh.sysl.tekton.options.parse_options
import sh.sysl.tekton.scenes.{add_demo_scene, add_hole_scene}
import sh.sysl.ui.signal
import sh.sysl.ui_sdl.{app, run, save_frame, stop}
import sysl.text.{parse_int, split}

// How many frames a shot lets pass first, for the window and the shaders to settle.
const SHOT_SETTLE: int = 5

main(args: []string) -> Result[unit, string]
    val o = parse_options(args)?

    // A script reads the one line, so a failed export does not add the trace of where it failed.
    if o.export != ""
        export_command(o) match
            Ok(_) -> return Ok(())
            Err(why) ->
                eprints(s"error: ${why}\n")
                exit(1)

    val shot = o.shot
    val demo = o.demo
    val holes = o.holes
    val selected = o.selected
    val view = o.view
    val opened = o.opened
    val file = o.file
    val w = new_workspace()

    if file != "" && !w.open_path(file) then eprints(s"${w.problem.read()}\n")

    if holes then add_hole_scene(w.doc)

    if demo then add_demo_scene(w.doc)

    if selected != ""
        w.doc.select(None)

        for one in split(selected, ",")
            w.doc.toggle_selected(parse_int(one).ok().ok_or(s"not a shape: ${one}")?)

    if demo || holes
        w.camera.frame(w.doc)

        view match
            Some((turn, tilt)) ->
                w.camera.turn = turn
                w.camera.tilt = tilt
            None -> ()

    if opened != "" && !w.show_menu(opened) then return Err(s"not a menu: ${opened}")

    val frames = signal(0)

    val routes: &Fn(Request) -> Routed = req -> live_routes(w, req)

    run(app(w.title(), () -> w.tree(), () -> 0xDDE2E9u32, o.width, o.height, gpu = GPU_SHADERFORMAT_MSL,
            control = o.control, routes = routes, hidden = o.hidden, on_event = e ->
        e.kind() match
            Quit | WindowCloseRequested ->
                w.request_quit()
                true
            KeyDown -> w.shortcut(e.key_code(), e.key_mod(), e.key_repeat())
            _ -> false
    , on_frame = dt ->
        deliver_dialogs()
        w.next_frame(dt)

        if shot != ""
            frames.set(frames.read() + 1)

            if frames.read() == SHOT_SETTLE then save_frame(shot)
            if frames.read() > SHOT_SETTLE + 1 then stop()
    ))
end main
