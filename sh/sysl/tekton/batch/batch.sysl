module sh.sysl.tekton.batch

// What `tekton` does without a window: the document the command line names, written out for a slicer.

import sh.sysl.tekton.document.new_document
import sh.sysl.tekton.export.{export_file, export_format}
import sh.sysl.tekton.files.load_file
import sh.sysl.tekton.options.Options
import sh.sysl.tekton.scenes.{add_demo_scene, add_hole_scene}

// Build the document the options name — the file, then the `--holes` and `--demo` scenes on top, as the window
// would show it — and write it to `o.export` in the format its extension names; or say why not, in one line.
export_command(o: Options) -> Result[unit, string]
    export_format(o.export)?

    val doc = if o.file == "" then new_document() else load_file(o.file).map_err(why -> s"Could not open ${o.file}: ${why}")?

    if o.holes then add_hole_scene(doc)
    if o.demo then add_demo_scene(doc)

    export_file(doc, o.export)
end export_command
