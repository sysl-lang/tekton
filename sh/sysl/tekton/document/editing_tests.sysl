module sh.sysl.tekton.document
@tests

import sh.sysl.tekton.space.Vec3
import sysl.buf.{Buf, buf}
import sysl.container.set

// Copy, Paste, Select All and the arrow keys' nudge: what the clipboard holds, where a paste lands, and that each
// command is one step.

private near(a: real, b: real) -> bool = (a - b).abs() <= 1.0e-9

private assert_at(doc: &Document, id: int, at: Vec3, what: string)
    val p = doc.find(id).unwrap().transform.translation

    for i in 0..<3 do assert(near(p.axis(i), at.axis(i)), s"${what}: axis ${i} is ${p.axis(i)}, not ${at.axis(i)}")
end assert_at

private ids_of(node: &Node, out: Buf[int])
    out.push(node.id)

    for child in node.children.view() do ids_of(child, out)
end ids_of

private all_ids_unique(doc: &Document) -> bool
    var ids: Buf[int] = buf()
    val seen = set[int]()

    for item in doc.items() do ids_of(item, ids)

    for id in ids.view() do if !seen.add(id) then return false

    true
end all_ids_unique

// A box at (10, 20, 5), then a cylinder of 12 sides, rounded, mirrored along x, a hole with clearance, at (50, 0, 0).
private odd_pair() -> (&Document, int, int)
    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val b = doc.add_shape(Primitive.Cylinder)

    doc.set_transform(a, moved_to(Vec3(10.0, 20.0, 5.0)))
    doc.set_transform(b, moved_to(Vec3(50.0, 0.0, 0.0)))
    doc.set_segments(b, 12).unwrap()
    doc.set_edge_radius(b, 1.5).unwrap()
    doc.select(Some(b))
    doc.mirror_selected(0).unwrap()
    doc.set_hole(true).unwrap()
    doc.set_clearance(b, 0.3).unwrap()
    (doc, a, b)
end odd_pair

// Two boxes grouped, at x = 0 and 40, with a third box beside at y = 60. The group is selected.
private group_and_box() -> (&Document, int, int)
    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val b = doc.add_shape(Primitive.Box)
    val c = doc.add_shape(Primitive.Box)

    doc.set_transform(a, moved_to(Vec3(0.0, 0.0, 0.0)))
    doc.set_transform(b, moved_to(Vec3(40.0, 0.0, 0.0)))
    doc.set_transform(c, moved_to(Vec3(0.0, 60.0, 0.0)))
    doc.select(Some(a))
    doc.toggle_selected(b)

    val g = doc.group_selected().unwrap()

    (doc, g, c)
end group_and_box

// ## Copy and paste

@test
copy_keeps_whole_items_and_changes_nothing()
    val (doc, a, b) = odd_pair()

    doc.select(Some(a))
    doc.toggle_selected(b)

    val before = doc.describe()
    val steps = doc.undos.len()
    val kept = doc.copy_selected().unwrap()

    assert_eq(kept.len(), 2, "both")
    assert_eq(kept[0].id, a, "in the order they stand")
    assert_eq(kept[1].id, b, "and the second")
    assert_eq(doc.describe(), before, "the document is as it was")
    assert_eq(doc.undos.len(), steps, "and no step was made")

@test
copy_with_nothing_selected_is_refused()
    val doc = new_document()

    doc.add_shape(Primitive.Box)
    doc.select(None)
    assert(doc.copy_selected().is_err(), "nothing to copy")

@test
a_paste_lands_one_step_beside_the_original_with_fresh_ids_and_is_selected()
    val (doc, a, b) = odd_pair()
    val kept = doc.copy_selected().unwrap()

    doc.paste(kept.view(), 1, 5.0).unwrap()
    assert_eq(doc.items().len, 3, "one more")
    assert_eq(doc.selection.len(), 1, "the copy is the selection")

    val copy = doc.find(doc.selection[0]).unwrap()
    val original = doc.find(b).unwrap()

    assert(copy.id != b && copy.id != a, "a fresh id")
    assert_at(doc, copy.id, Vec3(55.0, 0.0, 0.0), "one step along x")
    assert_at(doc, b, Vec3(50.0, 0.0, 0.0), "the original stays")
    assert_eq(copy.segments, Some(12), "segments")
    assert_eq(copy.edges.unwrap().radius, 1.5, "rounded edges")
    assert(copy.hole && copy.clearance == 0.3, "a hole with its clearance")
    assert(copy.mirror.any && copy.mirror == original.mirror, "mirror flags")
    assert(copy.tint == original.tint, "tint")
    assert(all_ids_unique(doc), "no id twice")

@test
a_second_paste_lands_one_step_beside_the_first()
    val (doc, a, _) = odd_pair()

    doc.select(Some(a))

    val kept = doc.copy_selected().unwrap()

    doc.paste(kept.view(), 1, 5.0).unwrap()

    val first = doc.selection[0]

    doc.paste(kept.view(), 2, 5.0).unwrap()

    val second = doc.selection[0]

    assert(first != second, "a copy of its own")
    assert_at(doc, first, Vec3(15.0, 20.0, 5.0), "the first")
    assert_at(doc, second, Vec3(20.0, 20.0, 5.0), "and the second a step on")
    assert_eq(doc.items().len, 4, "two pastes, two copies")
    assert(all_ids_unique(doc), "no id twice")

@test
a_pasted_group_has_every_part_with_ids_of_their_own()
    val (doc, g, _) = group_and_box()
    val kept = doc.copy_selected().unwrap()

    doc.paste(kept.view(), 1, 5.0).unwrap()

    val copy = doc.find(doc.selection[0]).unwrap()
    val original = doc.find(g).unwrap()

    assert(copy.is_group && copy.id != g, "a new group")
    assert_eq(copy.children.len(), 2, "both parts")

    for i in 0..<2
        assert(copy.children[i].id != original.children[i].id, s"part ${i} has an id of its own")
        assert(copy.children[i].transform == original.children[i].transform, s"part ${i} stands where it stood in the group")

    assert(all_ids_unique(doc), "no id twice")
    assert_at(doc, copy.id, original.transform.translation + Vec3(5.0, 0.0, 0.0), "the group a step along")

@test
a_paste_of_several_keeps_their_arrangement_and_selects_every_copy()
    val (doc, a, b) = odd_pair()

    doc.select(Some(a))
    doc.toggle_selected(b)

    val kept = doc.copy_selected().unwrap()

    doc.paste(kept.view(), 1, 5.0).unwrap()
    assert_eq(doc.selection.len(), 2, "both copies")
    assert_at(doc, doc.selection[0], Vec3(15.0, 20.0, 5.0), "the first")
    assert_at(doc, doc.selection[1], Vec3(55.0, 0.0, 0.0), "the second")
    assert(!doc.is_selected(a) && !doc.is_selected(b), "and not what they copy")

@test
a_paste_is_one_step_that_undo_and_redo_take_back_and_put_back()
    val (doc, a, _) = odd_pair()

    doc.select(Some(a))

    val kept = doc.copy_selected().unwrap()
    val before = doc.describe()
    val steps = doc.undos.len()

    doc.paste(kept.view(), 1, 5.0).unwrap()
    assert_eq(doc.undos.len(), steps + 1, "one step")

    val after = doc.describe()

    assert(doc.undo(), "back")
    assert_eq(doc.describe(), before, "as it was, selection and all")
    assert(doc.redo(), "forward")
    assert_eq(doc.describe(), after, "as it was after")

@test
a_paste_of_nothing_is_refused_and_so_is_one_beyond_the_limit()
    val (doc, a, _) = odd_pair()
    val empty: Buf[&Node] = buf()
    val steps = doc.undos.len()

    assert(doc.paste(empty.view(), 1, 5.0).is_err(), "an empty clipboard")
    doc.select(Some(a))

    val kept = doc.copy_selected().unwrap()

    assert(doc.paste(kept.view(), 1, 5000.0).is_err(), "a copy past the limit")
    assert_eq(doc.undos.len(), steps, "no step for either")
    assert_eq(doc.items().len, 2, "and nothing added")

@test
a_clipboard_pastes_into_another_document_with_ids_of_its_own()
    val (doc, a, b) = odd_pair()

    doc.select(Some(b))

    val kept = doc.copy_selected().unwrap()
    val other = new_document()
    val mine = other.add_shape(Primitive.Sphere)

    other.paste(kept.view(), 1, 5.0).unwrap()
    assert_eq(other.items().len, 2, "there")
    assert_eq(doc.items().len, 2, "and the first has no more")

    val copy = other.find(other.selection[0]).unwrap()

    assert(copy.id != mine, "an id that is not the other's")
    assert(all_ids_unique(other), "no id twice")
    assert_at(other, copy.id, Vec3(55.0, 0.0, 0.0), "a step beside where it was copied from")
    assert(copy.hole && copy.mirror.any && copy.segments == Some(12), "everything about it")

@test
cut_is_copy_and_delete_and_the_paste_brings_it_back()
    val (doc, a, b) = odd_pair()

    doc.select(Some(b))

    val kept = doc.copy_selected().unwrap()

    doc.delete_selected().unwrap()
    assert(doc.find(b).is_none(), "gone")
    doc.paste(kept.view(), 1, 5.0).unwrap()
    assert_eq(doc.items().len, 2, "back")
    assert_at(doc, doc.selection[0], Vec3(55.0, 0.0, 0.0), "a step beside where it stood")

// ## Select all

@test
select_all_selects_every_top_level_item_and_is_not_a_step()
    val (doc, g, c) = group_and_box()
    val steps = doc.undos.len()

    doc.select(None)
    doc.select_all()
    assert_eq(doc.selection.len(), 2, "the group and the box, not the parts")
    assert(doc.is_selected(g) && doc.is_selected(c), "both")
    assert_eq(doc.undos.len(), steps, "no step")

@test
select_all_of_an_empty_document_selects_nothing()
    val doc = new_document()

    doc.select_all()
    assert_eq(doc.selection.len(), 0, "nothing")

@test
select_more_adds_to_the_selection_and_keeps_what_was_in_it()
    val (doc, a, b) = odd_pair()
    val ids: Buf[int] = buf()

    ids.push(a)
    ids.push(b)
    doc.select(Some(b))
    doc.select_more(ids)
    assert_eq(doc.selection.len(), 2, "each once")
    assert_eq(doc.selection[0], b, "what was there stays first")
    assert_eq(doc.selection[1], a, "and the rest joins")

// ## Nudge

@test
a_nudge_moves_everything_selected_and_is_one_step()
    val (doc, a, b) = odd_pair()

    doc.select(Some(a))
    doc.toggle_selected(b)

    val before = doc.describe()
    val steps = doc.undos.len()

    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    assert_at(doc, a, Vec3(11.0, 20.0, 5.0), "the first")
    assert_at(doc, b, Vec3(51.0, 0.0, 0.0), "the second")
    assert_eq(doc.undos.len(), steps + 1, "one step")
    assert(doc.undo(), "back")
    assert_eq(doc.describe(), before, "as it was")

@test
nudges_in_a_row_on_one_selection_are_one_step()
    val (doc, a, _) = odd_pair()

    doc.select(Some(a))

    val before = doc.describe()
    val steps = doc.undos.len()

    for i in 0..<5 do doc.nudge_selected(Vec3(0.0, 1.0, 0.0)).unwrap()

    assert_at(doc, a, Vec3(10.0, 25.0, 5.0), "five steps along")
    assert_eq(doc.undos.len(), steps + 1, "one undo step")
    assert(doc.undo(), "back")
    assert_eq(doc.describe(), before, "all of it")
    assert(doc.redo(), "and forward")
    assert_at(doc, a, Vec3(10.0, 25.0, 5.0), "all of it again")

@test
a_nudge_after_something_else_or_on_another_selection_is_a_step_of_its_own()
    val (doc, a, b) = odd_pair()

    doc.select(Some(a))
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()

    val steps = doc.undos.len()

    doc.select(Some(b))
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    assert_eq(doc.undos.len(), steps + 1, "another selection")
    doc.select(Some(a))
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    assert_eq(doc.undos.len(), steps + 2, "back on the first, after the second's")
    doc.set_clearance(a, 0.5).unwrap()
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    assert_eq(doc.undos.len(), steps + 4, "after another command")

@test
a_nudge_after_an_undo_and_after_a_redo_does_not_reach_into_the_step_before()
    val (doc, a, _) = odd_pair()

    doc.select(Some(a))
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()

    val steps = doc.undos.len()

    assert(doc.undo(), "back")
    assert_at(doc, a, Vec3(10.0, 20.0, 5.0), "both gone")
    doc.nudge_selected(Vec3(0.0, 1.0, 0.0)).unwrap()
    assert_eq(doc.undos.len(), steps, "a new step, in place of the undone one")
    assert(doc.undo(), "back again")
    assert_at(doc, a, Vec3(10.0, 20.0, 5.0), "to where the first began")

@test
a_nudge_along_z_and_by_a_fraction_moves_by_that_much()
    val (doc, a, _) = odd_pair()

    doc.select(Some(a))
    doc.nudge_selected(Vec3(0.0, 0.0, -1.0)).unwrap()
    doc.nudge_selected(Vec3(0.5, 0.0, 0.0)).unwrap()
    assert_at(doc, a, Vec3(10.5, 20.0, 4.0), "z and a half")

@test
a_nudge_moves_a_group_whole_and_leaves_its_parts_as_they_stood_in_it()
    val (doc, g, _) = group_and_box()
    val part = doc.find(g).unwrap().children[1].transform.translation
    val at = doc.find(g).unwrap().transform.translation

    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()
    assert_at(doc, g, at + Vec3(1.0, 0.0, 0.0), "the group")
    assert(doc.find(g).unwrap().children[1].transform.translation == part, "the part in its own space")

@test
a_nudge_with_nothing_selected_or_past_the_limit_is_refused_and_changes_nothing()
    val (doc, a, _) = odd_pair()
    val steps = doc.undos.len()

    doc.select(None)
    assert(doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).is_err(), "nothing selected")
    doc.select(Some(a))
    assert(doc.nudge_selected(Vec3(5000.0, 0.0, 0.0)).is_err(), "past the limit")
    assert_eq(doc.undos.len(), steps, "no step")
    assert_at(doc, a, Vec3(10.0, 20.0, 5.0), "where it was")

@test
a_nudge_of_a_mirrored_hole_with_rounded_edges_keeps_all_of_that()
    val (doc, _, b) = odd_pair()

    doc.select(Some(b))
    doc.nudge_selected(Vec3(1.0, 0.0, 0.0)).unwrap()

    val node = doc.find(b).unwrap()

    assert(node.hole && node.mirror.any && node.clearance == 0.3 && node.edges.unwrap().radius == 1.5, "as it was")
