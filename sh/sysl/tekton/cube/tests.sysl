module sh.sysl.tekton.cube
@tests

import sh.sysl.tekton.camera.{Camera, NamedView, new_camera}

// The view cube as numbers: no window, no GPU, no canvas.

private const W: real = 900.0
private const H: real = 600.0

private at_view(v: NamedView) -> &Camera
    val c = new_camera()

    c.go_to(v)
    c.advance(1.0)
    c
end at_view

private names(cube: &ViewCube) -> string
    var out = ""

    for l in cube.labels.view() do out += l.words + " "

    out

@test
from_home_the_top_front_and_right_face_the_viewer()
    val cube = view_cube(new_camera(), W, H)
    var faces = ""

    for q in cube.quads.view() do faces += NAMES[q.face] + " "

    assert_eq(faces, "Right Front Top ", "three faces toward the viewer")
    assert_eq(names(cube), "Front Top ", "and the two square enough to read named")
    assert(cube.strokes.len() > 0, "drawn")

@test
the_cube_sits_in_the_top_right_corner_inside_the_viewport()
    val cube = view_cube(new_camera(), W, H)

    assert(cube.x + CUBE_REACH <= W && cube.x - CUBE_REACH > W * 0.5, "at the right")
    assert(cube.y - CUBE_REACH >= 0.0 && cube.y + CUBE_REACH < H * 0.5, "at the top")

    for s in cube.strokes.view()
        assert(s.ax >= cube.x - CUBE_REACH - 1.0e-9 && s.ax <= cube.x + CUBE_REACH + 1.0e-9, "every stroke on it")
        assert(s.ay >= cube.y - CUBE_REACH - 1.0e-9 && s.ay <= cube.y + CUBE_REACH + 1.0e-9, "every stroke on it")

@test
a_point_on_a_face_names_the_view_straight_at_it()
    val cube = view_cube(new_camera(), W, H)

    for (name, v) in [("Top", NamedView.Top), ("Front", NamedView.Front)]
        val (x, y) = cube.spot(name).unwrap()

        assert(cube.face_at(x, y) == Some(v), name)
        assert(cube.holds(x, y), "and the cube holds it")

    assert(cube.face_at(cube.x + CUBE_REACH, cube.y + CUBE_REACH).is_none(), "off the faces, nothing")
    assert(!cube.holds(10.0, 10.0), "and the far corner of the viewport is not the cube's")

@test
the_right_face_is_pressable_even_where_it_is_too_thin_to_name()
    val cube = view_cube(new_camera(), W, H)
    var found = false

    for q in cube.quads.view()
        if NAMES[q.face] == "Right"
            val x = (q.xs[0] + q.xs[1] + q.xs[2] + q.xs[3]) * 0.25
            val y = (q.ys[0] + q.ys[1] + q.ys[2] + q.ys[3]) * 0.25

            assert(cube.face_at(x, y) == Some(NamedView.Right), "its middle is the right view")
            found = true

    assert(found, "the right face is there")

@test
from_straight_above_only_the_top_shows()
    val cube = view_cube(at_view(NamedView.Top), W, H)

    assert_eq(cube.quads.len(), 1, "one face")
    assert_eq(names(cube), "Top ", "named Top")

    val (x, y) = cube.spot("Top").unwrap()

    assert((x - cube.x).abs() < 1.0e-9 && (y - cube.y).abs() < 1.0e-9, "in the middle of the cube")

@test
each_side_view_shows_its_own_face_square_on()
    for (v, name) in [(NamedView.Front, "Front"), (NamedView.Right, "Right"), (NamedView.Back, "Back"),
                      (NamedView.Left, "Left")]
        val cube = view_cube(at_view(v), W, H)

        assert_eq(names(cube), name + " ", name)
        assert(cube.face_at(cube.x, cube.y) == Some(v), "its middle goes back to it")

@test
the_bottom_never_shows_and_has_no_view()
    for tilt in [0.0, 0.07, 0.5, 1.55]
        val c = new_camera()

        c.tilt = tilt

        for q in view_cube(c, W, H).quads.view() do assert(NAMES[q.face] != "Bottom", "no bottom face")

    assert(face_view(5).is_none(), "and none to go to")

@test
the_cube_turns_with_the_view_on_its_way()
    val c = new_camera()
    val before = view_cube(c, W, H).spot("Top").unwrap()

    c.go_to(NamedView.Top)
    c.advance(0.1)

    val during = view_cube(c, W, H).spot("Top").unwrap()

    assert(during != before, "the top has turned toward the viewer")
    assert(during.1 > before.1, "lower on the cube, nearer its middle")

@test
the_cube_is_the_same_in_either_projection()
    val c = new_camera()
    val a = view_cube(c, W, H)

    c.toggle_orthographic()

    val b = view_cube(c, W, H)

    assert_eq(a.strokes.len(), b.strokes.len(), "as many strokes")

    for i in 0..<a.strokes.len()
        assert(a.strokes[i].ax == b.strokes[i].ax && a.strokes[i].by == b.strokes[i].by, "in the same places")

@test
a_viewport_with_no_room_has_no_cube()
    val cube = view_cube(new_camera(), 0.0, 0.0)

    assert(cube.strokes.len() == 0 && cube.quads.len() == 0 && cube.labels.len() == 0, "nothing to place")
