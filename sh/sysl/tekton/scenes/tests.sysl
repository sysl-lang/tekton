module sh.sysl.tekton.scenes

import sh.sysl.tekton.document.{Document, Node, PLACEMENT_GAP, PRIMITIVES, Primitive, new_document, primitive_name}
import sh.sysl.tekton.printer.CORE_ONE
import sh.sysl.tekton.space.Vec3

private demo() -> &Document
    val doc = new_document()

    add_demo_scene(doc)
    doc
end demo

private kind(node: &Node) -> string =
    node.operation match
        Shape(p, _, _) -> primitive_name(p)
        _ -> "not a shape"

@test
private every_demo_shape_stands_on_the_core_one_bed()
    val doc = demo()

    for item in doc.items() do assert(CORE_ONE.holds(doc.bounds_of(item)), s"${kind(item)} is on the bed")

    assert(CORE_ONE.holds(doc.solid_bounds().unwrap()), "the whole row")
end every_demo_shape_stands_on_the_core_one_bed

@test
private the_demo_row_keeps_the_palette_order_and_spacing_centred_on_the_bed()
    val doc = demo()
    val items = doc.items()

    assert_eq(items.len, PRIMITIVES.len)

    for i in 0..<items.len
        assert_eq(kind(items[i]), primitive_name(PRIMITIVES[i]))

        val b = doc.bounds_of(items[i])

        assert_eq(b.min.z, 0.0)
        assert_eq(b.min.y + b.max.y, 0.0)

        if i > 0 then assert_eq(b.min.x - doc.bounds_of(items[i - 1]).max.x, PLACEMENT_GAP)

    val row = doc.solid_bounds().unwrap()

    assert_eq(row.min.x, -row.max.x)
    assert(row.max.x < CORE_ONE.width * 0.5, "short of the edge")
    assert_eq(doc.selection.len(), 1)
    assert_eq(doc.selection[0], items[1].id)
end the_demo_row_keeps_the_palette_order_and_spacing_centred_on_the_bed

@test
private moving_the_demo_row_onto_the_bed_is_one_undo_step()
    val doc = demo()

    assert(doc.undo(), "the move")
    assert_eq(doc.items().len, PRIMITIVES.len)
    assert_eq(doc.bounds_of(doc.items()[0]).min.x, -doc.bounds_of(doc.items()[0]).max.x)
    assert(!CORE_ONE.holds(doc.solid_bounds().unwrap()), "where the palette put them, the torus is past the edge")
end moving_the_demo_row_onto_the_bed_is_one_undo_step

@test
private the_demo_beside_shapes_already_there_leaves_them_where_they_are()
    val doc = new_document()
    val box = doc.add_shape(Primitive.Box)

    doc.move_to(box, Vec3(-100.0, 60.0, 0.0)).unwrap()
    add_demo_scene(doc)

    assert_eq(doc.items().len, PRIMITIVES.len + 1)
    assert(doc.find(box).unwrap().transform.translation == Vec3(-100.0, 60.0, 0.0), "the box stays")
end the_demo_beside_shapes_already_there_leaves_them_where_they_are

@test
private the_hole_scene_is_a_drilled_group_and_a_block_with_a_loose_hole()
    val doc = new_document()

    add_hole_scene(doc)

    assert_eq(doc.items().len, 3)
    assert_eq(kind(doc.items()[0]), "not a shape")
    assert(doc.items()[2].hole, "the sphere is a hole")
    assert(doc.final_solid().is_ok(), "it exports")
end the_hole_scene_is_a_drilled_group_and_a_block_with_a_loose_hole
