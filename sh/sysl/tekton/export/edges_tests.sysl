module sh.sysl.tekton.export
@tests

import sh.sysl.quaternion.Quaternion
import sh.sysl.tekton.document.{Edges, Node, Primitive, Transform, restored_document, restored_shape}
import sh.sysl.tekton.space.Vec3
import sysl.buf.{Buf, buf}
import sysl.encoding.get_u32_le

// What an exported file holds for a shape with finished edges.

private stl_real(b: []const u8, at: usize) -> real = real(f32.from_bits(get_u32_le(b[at..<at + 4]).unwrap()))

private stl_point(b: []const u8, at: usize) -> Vec3 = Vec3(stl_real(b, at), stl_real(b, at + 4), stl_real(b, at + 8))

private stl_volume(bytes: Buf[u8]) -> real
    val b = bytes.view()
    var sum = 0.0

    for i in 0..<usize(get_u32_le(b[80..<84]).unwrap())
        val at = 84 + 50 * i + 12

        sum += stl_point(b, at).dot(stl_point(b, at + 12).cross(stl_point(b, at + 24))) / 6.0

    sum
end stl_volume

// A 40 by 20 by 10 mm box as a file says it: the palette's 20 mm box scaled, every edge chamfered 3 mm.
@test
an_exported_chamfered_box_is_the_box_grown_by_an_octahedron()
    var items: Buf[&Node] = buf()
    val t = Transform(Vec3(5.0, -3.0, 0.0), Quaternion.identity(), Vec3(2.0, 1.0, 0.5))

    items.push(restored_shape(1, Primitive.Box, t, 0, false, edges = Edges(3.0, true)))

    val read = stl_volume(stl_bytes(restored_document(items, 2, None, 1).final_mesh().unwrap()))

    // The box shrunk 3 mm on every side is 34 by 14 by 4.
    val want = 34.0 * 14.0 * 4.0 + 6.0 * (34.0 * 14.0 + 14.0 * 4.0 + 4.0 * 34.0) + 18.0 * (34.0 + 14.0 + 4.0) + 36.0

    assert((read - want).abs() <= want * 1.0e-5, s"${read} against ${want}, to a float's precision")
    assert((read - 8000.0).abs() > 100.0, "less than the sharp box")
end an_exported_chamfered_box_is_the_box_grown_by_an_octahedron
