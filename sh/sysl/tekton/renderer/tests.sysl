module sh.sysl.tekton.renderer
@tests

import sh.sysl.sdl3.{GPU_TEXTUREFORMAT_D32_FLOAT, GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, GPU_TEXTUREUSAGE_COLOR_TARGET,
                     GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET, GPU_TRANSFERBUFFERUSAGE_DOWNLOAD,
                     GPU_SHADERFORMAT_MSL, GpuDevice, gpu_device, init, INIT_VIDEO}
import sysl.buf.{Buf, buf}
import sh.sysl.tekton.camera.new_camera
import sh.sysl.quaternion.Quaternion
import sh.sysl.tekton.document.{Document, FLOATS_PER_VERTEX, Primitive, Transform, moved_to, new_document}
import sh.sysl.tekton.handles.Stroke
import sh.sysl.tekton.printer.{CORE_ONE, Printer}
import sh.sysl.tekton.space.Vec3
import sysl.process

// Real pixels from a real device, with no window: the shaders compile, the projection lands where a click
// would look, and the selection shows.
//
// **Only inside the macOS desktop session**, asked before SDL starts because it is SDL starting that would
// otherwise never return. Anywhere else each test says it did not run, and passes.

const SIZE: u32 = 128

private can_use_gpu(test: string) -> bool
    val here = process.capture("/bin/launchctl", ["managername"]) match
        Ok(out) -> out.text.starts_with("Aqua")
        Err(e) -> false

    if !here then print(s"skipped outside the desktop session: ${test}")
    here
end can_use_gpu

private device() -> &GpuDevice
    assert(init(INIT_VIDEO), "SDL started")
    gpu_device(GPU_SHADERFORMAT_MSL).unwrap()

// A frame of this document, as bytes of RGBA, drawn by this renderer on the device that made it.
private frame(dev: &GpuDevice, r: &Renderer, doc: &Document, strokes: []const Stroke = [], printer: Printer = CORE_ONE,
              volume: bool = true) -> Buf[u8]
    val color = dev.texture(GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, GPU_TEXTUREUSAGE_COLOR_TARGET, SIZE, SIZE).unwrap()
    val depth = dev.texture(GPU_TEXTUREFORMAT_D32_FLOAT, GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET, SIZE, SIZE).unwrap()
    val readback = dev.transfer_buffer(GPU_TRANSFERBUFFERUSAGE_DOWNLOAD, SIZE * SIZE * 4).unwrap()
    val cmd = dev.command_buffer().unwrap()

    r.draw(dev, cmd, color, depth, GPU_TEXTUREFORMAT_D32_FLOAT, GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, doc, new_camera(),
           real(SIZE), real(SIZE), 1.0, strokes, printer, volume)

    val out = cmd.copy_pass().unwrap()

    out.download_texture(color, readback)
    out.finish()
    assert(cmd.submit_with_fence(dev).unwrap().wait(), "the GPU finished")

    val bytes: *u8 = readback.map()
    var pixels: Buf[u8] = buf()

    for i in 0..<usize(SIZE * SIZE * 4) do pixels.push(bytes[i])

    readback.unmap()
    pixels
end frame

// How many pixels are mostly the selection's blue.
@test
a_hole_lets_what_is_behind_it_show_and_a_solid_does_not()
    if !can_use_gpu("a_hole_lets_what_is_behind_it_show") then return

    val dev = device()
    val doc = new_document()
    val id = doc.add_shape(Primitive.Box)
    val middle = doc.bounds_of(doc.find(id).unwrap()).center()
    val (x, y) = new_camera().project(middle, real(SIZE), real(SIZE)).unwrap()

    doc.select(None)

    val solid = pixel_at(frame(dev, new_renderer(), doc), x, y)

    doc.select(Some(id))
    doc.set_hole(true).unwrap()
    doc.select(None)

    val hole = pixel_at(frame(dev, new_renderer(), doc), x, y)

    doc.undo()
    doc.select(None)
    assert(hole != solid, "a hole does not look like the solid it was")
    assert(pixel_at(frame(dev, new_renderer(), doc), x, y) == solid, "and undoing it draws the solid again")
end a_hole_lets_what_is_behind_it_show_and_a_solid_does_not

@test
a_hole_buried_in_a_solid_can_still_be_seen_through_it()
    if !can_use_gpu("a_hole_buried_in_a_solid") then return

    val dev = device()
    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val middle = doc.bounds_of(doc.find(a).unwrap()).center()
    val (x, y) = new_camera().project(middle, real(SIZE), real(SIZE)).unwrap()

    doc.select(None)

    val plain = pixel_at(frame(dev, new_renderer(), doc), x, y)
    val b = doc.add_shape(Primitive.Sphere)

    doc.set_transform(b, Transform(Vec3(0.0, 0.0, 5.0), Quaternion.identity(), Vec3(0.5, 0.5, 0.5)))
    doc.select(Some(b))
    doc.set_hole(true).unwrap()
    doc.select(None)

    assert(pixel_at(frame(dev, new_renderer(), doc), x, y) != plain, "the box's face shows what is inside it")
end a_hole_buried_in_a_solid_can_still_be_seen_through_it

// Its surface is see-through and its depth is not, so an outline's back faces do not flood the shape.
@test
a_selected_hole_has_an_outline_and_not_a_blue_body()
    if !can_use_gpu("a_selected_hole_has_an_outline") then return

    val dev = device()
    val doc = new_document()

    doc.add_shape(Primitive.Sphere)

    val solid = selection_pixels(frame(dev, new_renderer(), doc))

    doc.set_hole(true).unwrap()

    val hole = selection_pixels(frame(dev, new_renderer(), doc))

    assert(hole > 0, "it shows")
    assert(hole <= solid * 2, "about as much as a solid's")
end a_selected_hole_has_an_outline_and_not_a_blue_body

@test
everything_selected_has_an_outline()
    if !can_use_gpu("everything_selected_has_an_outline") then return

    val dev = device()
    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val b = doc.add_shape(Primitive.Box)

    doc.select(Some(a))

    val one = selection_pixels(frame(dev, new_renderer(), doc))

    doc.toggle_selected(b)
    assert(selection_pixels(frame(dev, new_renderer(), doc)) > one, "two have more of it than one")
end everything_selected_has_an_outline

// A group an edit emptied has no triangles, and a buffer of no bytes is one a GPU refuses.
@test
a_group_with_nothing_left_of_it_draws_nothing_without_a_crash()
    if !can_use_gpu("a_group_with_nothing_left_of_it") then return

    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val b = doc.add_shape(Primitive.Box)

    doc.select(Some(a))
    doc.toggle_selected(b)
    doc.group_selected().unwrap()
    doc.set_transform(b, Transform(Vec3(-200.0, -200.0, -200.0), Quaternion.identity(), Vec3(40.0, 40.0, 40.0)))
    doc.set_part_hole(b, true)

    val renderer = new_renderer()

    frame(device(), renderer, doc)
    assert_eq(renderer.uploads, 0, "nothing went up")
end a_group_with_nothing_left_of_it_draws_nothing_without_a_crash

private pixel_at(p: Buf[u8], x: real, y: real) -> (u8, u8, u8)
    val at = (usize(y) * usize(SIZE) + usize(x)) * 4

    (p[at], p[at + 1], p[at + 2])
end pixel_at

private selection_pixels(p: Buf[u8]) -> int
    var count = 0

    for i in 0..<usize(SIZE * SIZE)
        if p[i * 4] < 60 && p[i * 4 + 1] < 170 && p[i * 4 + 2] > 200 then count += 1

    count
end selection_pixels

@test
a_shape_covers_the_ground_where_the_camera_says_it_is()
    if !can_use_gpu("a_shape_covers_the_ground") then return

    val doc = new_document()
    val id = doc.add_shape(Primitive.Box)
    val bounds = doc.bounds_of(doc.find(id).unwrap())
    val (x, y) = new_camera().project(bounds.center(), real(SIZE), real(SIZE)).unwrap()
    val p = frame(device(), new_renderer(), doc)
    val at = (usize(y) * usize(SIZE) + usize(x)) * 4

    assert(p[at] > p[at + 2], "the box's warm colour at its centre, not the cool ground")

@test
the_selected_shape_has_an_outline_and_an_unselected_one_does_not()
    if !can_use_gpu("the_selected_shape_has_an_outline") then return

    val dev = device()
    val doc = new_document()

    doc.add_shape(Primitive.Box)
    assert(selection_pixels(frame(dev, new_renderer(), doc)) > 20, "selected: a blue edge")

    doc.select(None)
    assert_eq(selection_pixels(frame(dev, new_renderer(), doc)), 0, "unselected: none")

@test
a_mesh_goes_to_the_gpu_once_until_its_revision_changes()
    if !can_use_gpu("a_mesh_goes_to_the_gpu_once") then return

    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val r = new_renderer()
    val dev = device()

    frame(dev, r, doc)
    assert_eq(r.uploads, 1, "the first frame")

    frame(dev, r, doc)
    assert_eq(r.uploads, 1, "the second, nothing")

    doc.set_transform(a, moved_to(Vec3(30.0, 0.0, 0.0)))
    frame(dev, r, doc)
    assert_eq(r.uploads, 1, "a move, nothing: the same triangles under a new matrix")

    doc.add_shape(Primitive.Sphere)
    frame(dev, r, doc)
    assert_eq(r.uploads, 2, "a new shape, once more")

private warm_at(p: Buf[u8], x: real, y: real) -> bool
    val at = (usize(y) * usize(SIZE) + usize(x)) * 4

    p[at] > p[at + 2]

// The picture has to follow the transform with no new mesh, for all three things a transform does.
@test
a_shape_is_drawn_where_its_transform_puts_it()
    if !can_use_gpu("a_shape_is_drawn_where_its_transform_puts_it") then return

    val dev = device()
    val doc = new_document()
    val a = doc.add_shape(Primitive.Box)
    val r = new_renderer()
    val camera = new_camera()
    val size = real(SIZE)
    val (x0, y0) = camera.project(Vec3(0.0, 0.0, 10.0), size, size).unwrap()

    assert(warm_at(frame(dev, r, doc), x0, y0), "first where it starts")

    doc.set_transform(a, moved_to(Vec3(25.0, 0.0, 0.0)))

    val moved = frame(dev, r, doc)
    val (x1, y1) = camera.project(Vec3(25.0, 0.0, 10.0), size, size).unwrap()

    assert(warm_at(moved, x1, y1), "then where it moved to")
    assert(!warm_at(moved, x0, y0), "and no longer where it was")

    // Stretched along y and turned a quarter about z, its long side lies along x.
    doc.set_transform(a, Transform(Vec3(0.0, 0.0, 0.0), Quaternion.from_axis_angle([0.0, 0.0, 1.0], 1.5708), Vec3(1.0, 2.5, 1.0)))

    val (x2, y2) = camera.project(Vec3(22.0, 0.0, 10.0), size, size).unwrap()

    assert(warm_at(frame(dev, r, doc), x2, y2), "and it reaches there when stretched and turned")

// A selected shape hidden behind another still shows its handles, because the strokes test no depth.
@test
handles_show_through_a_shape_standing_in_front()
    if !can_use_gpu("handles_show_through_a_shape_standing_in_front") then return

    val dev = device()
    val doc = new_document()
    val camera = new_camera()
    val size = real(SIZE)
    val hidden = doc.add_shape(Primitive.Box)
    val front = doc.add_shape(Primitive.Box)

    // Between the camera and the first, and much bigger, so it hides it entirely.
    val toward = camera.forward() * -40.0

    doc.set_transform(front, Transform(Vec3(toward.x, toward.y, 0.0), Quaternion.identity(), Vec3(3.0, 3.0, 3.0)))
    doc.select(Some(hidden))

    val (x, y) = camera.project(Vec3(0.0, 0.0, 20.0), size, size).unwrap()
    val p = frame(dev, new_renderer(), doc, [Stroke(x, y, x, y, 6.0, [0.0, 1.0, 0.0, 1.0])])
    val at = (usize(y) * usize(SIZE) + usize(x)) * 4

    assert(p[at + 1] > 240 && p[at] < 20 && p[at + 2] < 20, "the stroke's colour, in front of everything")
    assert(warm_at(frame(dev, new_renderer(), doc), x, y), "and without it, the shape that hides it")

// A printer small enough that the default camera sees all of its bed and volume in a test's frame.
private val SMALL = Printer("small", 46.0, 46.0, 30.0)

// One so large that nothing of its edge is in the frame.
private val HUGE = Printer("huge", 2000.0, 2000.0, 2000.0)

// Whether any pixel within one of this point differs between the two frames: a line one pixel wide lands on
// whichever pixel the rasteriser picks, which can be the projected point's neighbour.
private differs_near(a: Buf[u8], b: Buf[u8], x: real, y: real) -> bool
    for dy in [-1.0, 0.0, 1.0]
        for dx in [-1.0, 0.0, 1.0]
            if pixel_at(a, x + dx, y + dy) != pixel_at(b, x + dx, y + dy) then return true

    false
end differs_near

@test
private the_volume_goes_up_as_two_vertices_an_edge_laid_out_as_a_mesh()
    val v = volume_vertices(CORE_ONE)
    val edges = CORE_ONE.volume_edges()

    assert_eq(VOLUME_VERTICES, 24)
    assert_eq(v.len(), VOLUME_VERTICES * FLOATS_PER_VERTEX)

    for i in 0..<VOLUME_VERTICES
        val at = i * FLOATS_PER_VERTEX

        assert_eq(v[at], f32(edges[i].x))
        assert_eq(v[at + 1], f32(edges[i].y))
        assert_eq(v[at + 2], f32(edges[i].z))

        for k in 3..<6 do assert_eq(v[at + k], 0.0, "no normal")
end the_volume_goes_up_as_two_vertices_an_edge_laid_out_as_a_mesh

// The bed's edge is drawn as a border, and past it the floor is not the bed: both differ from the same pixels
// on a bed so large its edge is out of sight.
@test
private the_bed_has_a_border_and_ends_there()
    if !can_use_gpu("the_bed_has_a_border_and_ends_there") then return

    val dev = device()
    val doc = new_document()
    val camera = new_camera()
    val small = frame(dev, new_renderer(), doc, printer = SMALL, volume = false)
    val huge = frame(dev, new_renderer(), doc, printer = HUGE, volume = false)
    val (bx, by) = camera.project(Vec3(23.0, 3.0, 0.0), real(SIZE), real(SIZE)).unwrap()
    val (ox, oy) = camera.project(Vec3(33.0, 3.0, 0.0), real(SIZE), real(SIZE)).unwrap()
    val (ix, iy) = camera.project(Vec3(13.0, 3.0, 0.0), real(SIZE), real(SIZE)).unwrap()

    assert(pixel_at(small, bx, by) != pixel_at(huge, bx, by), "the border")
    assert(pixel_at(small, ox, oy) != pixel_at(huge, ox, oy), "the floor past it")
    assert(pixel_at(small, ix, iy) == pixel_at(huge, ix, iy), "and inside, a bed is a bed whatever its size")

    val (r, g, b) = pixel_at(small, bx, by)
    val (r0, g0, b0) = pixel_at(small, ix, iy)

    assert(int(r) + int(g) + int(b) < int(r0) + int(g0) + int(b0) - 60, "the border is clearly darker than the bed")
end the_bed_has_a_border_and_ends_there

// The volume's edges show where `volume` asks for them, and a solid standing in front of one hides it.
@test
private the_volume_outline_shows_when_asked_and_hides_behind_a_solid()
    if !can_use_gpu("the_volume_outline_shows_when_asked") then return

    val dev = device()
    val camera = new_camera()
    val empty = new_document()
    val (x, y) = camera.project(Vec3(23.0, 23.0, 15.0), real(SIZE), real(SIZE)).unwrap()
    val (tx, ty) = camera.project(Vec3(0.0, 23.0, 30.0), real(SIZE), real(SIZE)).unwrap()
    val shown = frame(dev, new_renderer(), empty, printer = SMALL)
    val hidden = frame(dev, new_renderer(), empty, printer = SMALL, volume = false)

    assert(differs_near(shown, hidden, x, y), "an upright edge")
    assert(differs_near(shown, hidden, tx, ty), "and a top one")

    val doc = new_document()
    val id = doc.add_shape(Primitive.Box)

    doc.set_transform(id, Transform(Vec3(23.0, 23.0, 0.0), Quaternion.identity(), Vec3(1.0, 1.0, 1.0)))
    doc.select(None)

    assert(!differs_near(frame(dev, new_renderer(), doc, printer = SMALL), frame(dev, new_renderer(), doc, printer = SMALL, volume = false), x, y),
           "the box in front of the edge hides it")
end the_volume_outline_shows_when_asked_and_hides_behind_a_solid

private sent_for(r: &Renderer) -> Option[Printer] =
    r.volume match
        Some((printer, _)) -> Some(printer)
        None -> None

// The edges go to the GPU for the printer they are drawn for, and again when the printer changes.
@test
private the_volume_follows_the_printer()
    if !can_use_gpu("the_volume_follows_the_printer") then return

    val dev = device()
    val r = new_renderer()
    val doc = new_document()

    frame(dev, r, doc, volume = false)
    assert(r.volume.is_none(), "nothing sent while hidden")

    frame(dev, r, doc, printer = SMALL)
    assert(sent_for(r) == Some(SMALL), "sent for the small printer")

    frame(dev, r, doc)
    assert(sent_for(r) == Some(CORE_ONE), "and again for the CORE One")
end the_volume_follows_the_printer
