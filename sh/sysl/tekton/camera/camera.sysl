module sh.sysl.tekton.camera

import sh.sysl.quaternion.{Quaternion, slerp}
import sh.sysl.tekton.space.{Mat4, Ray, Vec3, vec3}
import sh.sysl.tekton.document.Document
import sysl.math.{max, min}

// A camera orbiting a point near the ground.
//
// **It keeps a turn and a tilt rather than an orientation**, because those are what a clamp can speak to:
// the tilt stays above the ground and short of straight down, so the view can neither flip over nor go
// under the model. The quaternion is what turns them into directions, with no gimbal to fall into at the
// top of the range.
//
// **A named view may stand outside the clamp a drag keeps to**: Top looks straight down and the side views
// look level along the ground. A drag from there turns back into the range and never further out.
//
// **Going to a view turns there over a moment rather than jumping.** The turn and tilt are set to where the
// view ends at once, so everything that asks where the camera is going has its answer; what is drawn, picked
// and measured follows the orientation on the way, which is the short arc between the two.
//
// **Orthographic keeps the same scale at the target**: its view is as tall as the perspective view is at the
// target's depth, so switching changes nothing there, and the distance is what zooming changes in either.

const MIN_TILT: real = 0.07
const MAX_TILT: real = 1.55
const MIN_DISTANCE: real = 15.0
const MAX_DISTANCE: real = 2500.0

// How far the view's centre may wander from the origin along the ground, and above it.
const PAN_LIMIT: real = 2000.0
const LIFT_LIMIT: real = 500.0

const NEAR_PLANE: real = 1.0
const FAR_PLANE: real = 8000.0

// Radians a drag of one point turns the view.
const ORBIT_RATE: real = 0.008

// How much one point of wheel changes the distance, as a power of e.
const ZOOM_RATE: real = 0.002

// How much room `frame` leaves around what it frames, as a multiple of its size.
const FRAME_MARGIN: real = 1.05

// The shape of the view a new shape's visibility is judged in. A placement has no viewport to ask.
const ASSUMED_ASPECT: real = 1.5

// How far behind the target an orthographic eye stands. Nothing is nearer or farther for it, so this only has
// to put everything there is between the near and far planes.
const ORTHO_BACK: real = 3000.0

// How long going to a view takes, in seconds.
const VIEW_SECONDS: real = 0.25

// How near a turn and tilt must be to a named view's to be called that view.
const VIEW_TOLERANCE: real = 1.0e-9

// The views with names: where a new document starts, and straight at each side or down from above.
enum NamedView
    Home
    Top
    Front
    Right
    Back
    Left
end NamedView

val NAMED_VIEWS: [6]NamedView = [NamedView.Home, NamedView.Top, NamedView.Front, NamedView.Right, NamedView.Back,
                                 NamedView.Left]

// What a view is called in a report.
view_name(v: NamedView) -> string =
    v match
        Home -> "home"
        Top -> "top"
        Front -> "front"
        Right -> "right"
        Back -> "back"
        Left -> "left"

// The turn a view has. Turning by a positive angle swings the eye from the front round to the right.
view_turn(v: NamedView) -> real =
    v match
        Home -> HOME_TURN
        Top | Front -> 0.0
        Right -> real.pi() * 0.5
        Back -> real.pi()
        Left -> -real.pi() * 0.5

// The tilt a view has: down from level.
view_tilt(v: NamedView) -> real =
    v match
        Home -> HOME_TILT
        Top -> real.pi() * 0.5
        _ -> 0.0

const HOME_TURN: real = 0.3
const HOME_TILT: real = 0.5

// An angle brought within half a turn of nothing either way.
private wrapped(a: real) -> real = a - (a / (2.0 * real.pi())).round() * 2.0 * real.pi()

// How far through going to a view looks, from 0 to 1: slow at both ends.
private eased(t: real) -> real = t * t * (3.0 - 2.0 * t)

struct Camera
    target: Vec3
    turn: real
    tilt: real
    distance: real
    fov: real
    orthographic: bool

    // Where going to a view set out from, and how far along it is, from 0 to 1 when it has arrived.
    from: Quaternion[real]
    progress: real

    // Which way the view looks now, part way to a view or settled.
    private orientation(&self) -> Quaternion[real]
        val settled = Quaternion.from_axis_angle([0.0, 0.0, 1.0], self.turn) *
                      Quaternion.from_axis_angle([1.0, 0.0, 0.0], -self.tilt)

        if self.progress >= 1.0 then settled else slerp(self.from, settled, eased(self.progress))

    // Set out for a view, keeping the target and the distance. The turn goes the short way round.
    go_to(&self, v: NamedView)
        self.from = self.orientation()
        self.progress = 0.0
        self.turn = self.turn + wrapped(view_turn(v) - self.turn)
        self.tilt = view_tilt(v)

    // Let this many seconds of going to a view pass.
    advance(&self, seconds: real) =
        if self.progress < 1.0 then self.progress = (self.progress + seconds / VIEW_SECONDS).clamp(0.0, 1.0)

    // Whether it is still on the way to a view.
    moving(&self) -> bool = self.progress < 1.0

    // The named view it is at or going to, or nothing once it has been turned by hand.
    named_view(&self) -> Option[NamedView]
        for v in NAMED_VIEWS
            val turned = wrapped(self.turn - view_turn(v)).abs()

            if turned <= VIEW_TOLERANCE && (self.tilt - view_tilt(v)).abs() <= VIEW_TOLERANCE then return Some(v)

        None
    end named_view

    // Switch between perspective and orthographic. What is at the target stays the size it was.
    toggle_orthographic(&self) = self.orthographic = !self.orthographic

    forward(&self) -> Vec3 = vec3(self.orientation().rotate([0.0, 1.0, 0.0]))

    right(&self) -> Vec3 = vec3(self.orientation().rotate([1.0, 0.0, 0.0]))

    up(&self) -> Vec3 = vec3(self.orientation().rotate([0.0, 0.0, 1.0]))

    eye(&self) -> Vec3 = self.target - self.forward() * (if self.orthographic then ORTHO_BACK else self.distance)

    // Turn the view by a drag of this many points. The model follows the pointer. A view on its way arrives
    // first, and a tilt outside the range a drag keeps to only comes back toward it.
    orbit(&self, dx: real, dy: real)
        self.progress = 1.0
        self.turn -= dx * ORBIT_RATE
        self.tilt = (self.tilt + dy * ORBIT_RATE).clamp(MIN_TILT.min(self.tilt), MAX_TILT.max(self.tilt))

    // Slide the view by a drag of this many points, across a viewport this many points tall, so what is at
    // the target's depth stays under the pointer.
    pan(&self, dx: real, dy: real, height: real)
        val scale = self.half_height() * 2.0 / height
        val t = self.target - self.right() * (dx * scale) + self.up() * (dy * scale)

        self.target = Vec3(t.x.clamp(-PAN_LIMIT, PAN_LIMIT), t.y.clamp(-PAN_LIMIT, PAN_LIMIT), t.z.clamp(0.0, LIFT_LIMIT))
    end pan

    // Move toward the view's centre, or away, by a turn of the wheel in points. Positive is toward.
    zoom(&self, amount: real) =
        self.distance = (self.distance * (-amount * ZOOM_RATE).exp()).clamp(MIN_DISTANCE, MAX_DISTANCE)

    // Look at everything in the document, from far enough back that it all fits.
    frame(&self, doc: &Document)
        val items = doc.items()

        if items.len == 0 then return

        var low = doc.bounds_of(items[0]).min
        var high = doc.bounds_of(items[0]).max

        for item in items
            val b = doc.bounds_of(item)

            low = Vec3(low.x.min(b.min.x), low.y.min(b.min.y), low.z.min(b.min.z))
            high = Vec3(high.x.max(b.max.x), high.y.max(b.max.y), high.z.max(b.max.z))

        val across = (high - low).length()

        self.target = (low + high) * 0.5
        self.distance = (across * FRAME_MARGIN / (self.fov * 0.5).tan() * 0.5).clamp(MIN_DISTANCE, MAX_DISTANCE)
    end frame

    // Frame the document, if the last shape placed has landed outside what is in view at this aspect.
    frame_if_out_of_view(&self, doc: &Document)
        val items = doc.items()

        if items.len == 0 then return

        val centre = doc.bounds_of(items[items.len - 1]).center()
        val (clip, w) = self.view_projection(ASSUMED_ASPECT).apply(centre)

        if w <= 0.0 || (clip.x / w).abs() > 0.9 || (clip.y / w).abs() > 0.9 then self.frame(doc)
    end frame_if_out_of_view

    // Half the view's height, in world units, at the target's depth.
    private half_height(&self) -> real = self.distance * (self.fov * 0.5).tan()

    // How many world units one point of a viewport this many points tall covers, at the depth of `p`.
    world_per_point(&self, p: Vec3, height: real) -> real
        val depth = if self.orthographic then self.distance else (p - self.eye()).dot(self.forward()).max(NEAR_PLANE)

        depth * (self.fov * 0.5).tan() * 2.0 / height

    // The ray through a point of a viewport of this size, with `y` running down it as a pointer's does. An
    // orthographic ray runs straight ahead from a point beside the eye.
    ray(&self, x: real, y: real, width: real, height: real) -> Ray
        val tangent = (self.fov * 0.5).tan()
        val across = (x / width * 2.0 - 1.0) * tangent * width / height
        val down = (y / height * 2.0 - 1.0) * tangent
        val aside = self.right() * across - self.up() * down

        if self.orthographic then return Ray(self.eye() + aside * self.distance, self.forward())

        Ray(self.eye(), (self.forward() + aside).unit())
    end ray

    // Where a point lands in a viewport of this size, and whether it is in front of the camera at all.
    project(&self, p: Vec3, width: real, height: real) -> Option[(real, real)]
        val (clip, w) = self.view_projection(width / height).apply(p)

        if w <= 0.0 then return None

        Some(((clip.x / w + 1.0) * 0.5 * width, (1.0 - clip.y / w) * 0.5 * height))
    end project

    // The matrix a shader takes world positions through, for a depth range of 0 to 1 at this aspect ratio.
    view_projection(&self, aspect: real) -> Mat4
        val r = self.right()
        val u = self.up()
        val f = self.forward()
        val e = self.eye()
        val view = Mat4([r.x, u.x, f.x, 0.0,
                         r.y, u.y, f.y, 0.0,
                         r.z, u.z, f.z, 0.0,
                         -r.dot(e), -u.dot(e), -f.dot(e), 1.0])
        val focal = 1.0 / (self.fov * 0.5).tan()

        if self.orthographic
            val scale = focal / self.distance
            val flat = 1.0 / (FAR_PLANE - NEAR_PLANE)
            val projection = Mat4([scale / aspect, 0.0, 0.0, 0.0,
                                   0.0, scale, 0.0, 0.0,
                                   0.0, 0.0, flat, 0.0,
                                   0.0, 0.0, -NEAR_PLANE * flat, 1.0])

            return projection * view

        val depth = FAR_PLANE / (FAR_PLANE - NEAR_PLANE)
        val projection = Mat4([focal / aspect, 0.0, 0.0, 0.0,
                               0.0, focal, 0.0, 0.0,
                               0.0, 0.0, depth, 1.0,
                               0.0, 0.0, -NEAR_PLANE * depth, 0.0])

        projection * view
    end view_projection
end Camera

// The view a new document opens on: from the front and to the right, looking down a little.
new_camera() -> &Camera = Camera(Vec3(0.0, 0.0, 8.0), HOME_TURN, HOME_TILT, 150.0, 0.7, false, Quaternion.identity(), 1.0)
