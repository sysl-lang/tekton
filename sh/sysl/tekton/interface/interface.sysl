module sh.sysl.tekton.interface

import sh.sysl.quaternion.Quaternion
import sh.sysl.tekton.camera.{Camera, new_camera}
import sh.sysl.sdl3.{DialogResult, FileFilter, KMOD_GUI, KMOD_SHIFT, MessageButton, MessageKind, Window, ask, ask_open_file,
                     ask_save_file, message_button}
import sh.sysl.tekton.document.{Document, Edge, MAX_WALL, MIN_WALL, PRIMITIVES, Pattern, Primitive, Transform, new_document, primitive_name}
import sh.sysl.tekton.export.{export_3mf, export_stl}
import sh.sysl.tekton.files.{export_answer, load_file, open_answer, save_answer, save_file}
import sh.sysl.tekton.handles.{Drag, DragKeys, Grip, Layout, drag_body, drag_grip, layout}
import sh.sysl.tekton.measure.{Mark, Measures, measures}
import sh.sysl.tekton.picking.{pick, pick_hit}
import sh.sysl.tekton.printer.{CORE_ONE, Printer}
import sh.sysl.tekton.renderer.{Renderer, new_renderer}
import sh.sysl.ui.*
import sh.sysl.ui_sdl.{VIEWPORT_COLOR_FORMAT, Viewport, set_title, stop, viewport, viewport_depth_format, window}
import sysl.buf.{Buf, buf}
import sysl.math.{max, min}
import sysl.path.file_name
import sysl.text.{parse_real, split, to_lower}

// The window: a menu bar over a palette beside one viewport.
//
// Everything the pointer can do arrives here and leaves as a command on the document or a move of the
// camera. **The slop is what tells a click from a drag**: a press that travels further than this over the
// viewport is a drag, and the canvas then does not report it as a tap. **What a drag is, is settled by where
// it began**: on a handle it works that handle, on a shape it moves that shape, and on empty space it turns
// the view.

// How far a press may wander, in points, and still be a click.
const CLICK_SLOP: int = 3

// The grid a drag snaps to unless told otherwise, in millimetres.
const DEFAULT_GRID: real = 1.0

const RADIANS_PER_DEGREE: real = real.pi() / 180.0

// How wide each of a row of three number fields is, and the keyboard id of the first.
const NUMBER_WIDTH: int = 52
const FIRST_FIELD_ID: int = 100

const WRONG_INK: u32 = 0xD92D20u32

// What an array lays its copies out as, in the order its panel offers them: the first three are lines along x, y
// and z, and the last two rings about an upright axis.
val ARRAY_KINDS = ["Line along X", "Line along Y", "Line along Z", "Ring about the middle", "Ring about the origin"]
const FIRST_RING: int = 3

// The keyboard ids of the array panel's count, spacing and angle fields.
const ARRAY_COUNT_ID: int = 120
const ARRAY_SPACING_ID: int = 121
const ARRAY_ANGLE_ID: int = 122

// The keyboard id of the hollow panel's wall field, and the choices of its top.
const HOLLOW_WALL_ID: int = 123
val HOLLOW_TOPS = ["Closed", "Open top"]

// What the question about unsaved changes answers for each of its buttons, and the line under its title.
const SAVE_ANSWER: i32 = 1
const DISCARD_ANSWER: i32 = 2
const CANCEL_ANSWER: i32 = 3
const QUESTION_DETAIL: string = "They are lost if you don't."

// How many characters of a file's name the panel has room for, and how many of a problem on one line.
const NAME_ROOM: usize = 28
const PROBLEM_ROOM: usize = 34

// What was asked for that would lose unsaved changes, and goes on once they are answered for.
enum Intent
    NewDocument
    OpenDocument
    Quit

// What an answer to the question about unsaved changes means: save and go on, go on without saving, or stay
// where things are, with the problem to report when the question could not be asked at all.
enum Unsaved
    SaveFirst
    Discard
    Stay(problem: string)

// What a file dialog is up for.
enum Asked
    Opening
    SavingAs(after: Option[Intent])
    ExportingStl
    Exporting3mf

// What the primary button is doing.
enum Gesture
    Idle
    Orbit
    Edit(drag: Drag)

// Which of the selection's numbers a field shows.
enum Quantity
    Position
    Size
    Rotation
    Segments
    Clearance
    EdgeRadius
    Wall

// A click selected or cleared the selection, or the palette added a shape. What a document's panel
// shows follows this.
struct Workspace
    doc: &Document
    camera: &Camera
    renderer: &Renderer
    view: Option[&Viewport]
    changes: &Signal[int]

    // The viewport's size in points as last painted, which a frame's pixels are divided by for its density.
    width: int
    height: int
    tap_waiting: bool

    gesture: Gesture
    grid: real

    // What the selection last put on the screen.
    overlay: &Layout
    fields: Buf[&NumberField]

    // What is wrong with the number last typed or the command last asked for, or nothing.
    problem: &Signal[string]

    // The rest of what a drag on one of several selected shapes carries along, where each began.
    carried: Buf[(int, Transform)]

    // Whether a field has the keyboard, as of the last frame. A shortcut leaves the document alone then, since
    // what is half typed into a field was written against the document as it stands.
    typing: bool

    // Which menu of the bar is open.
    open_menu: &Signal[int]

    // A press that began while a menu was open, until it is let go: it was the menu's, whatever became of the menu.
    menu_press: bool

    // What the File menu's Quit does.
    quit: &Fn() -> unit

    // The file this document came from or went to, or nothing.
    file: string

    // How the question about unsaved changes is asked, given its title and the window it belongs to, which a
    // test answers for itself. It answers once the question has been answered: the box is the system's own and
    // holds everything until then.
    ask_changes: &Fn(string, Option[&Window]) -> Result[Option[i32], string]

    // Whether a file dialog is up. Nothing may change under it: what it answers was asked about this document.
    in_dialog: &Signal[bool]

    // How a file dialog is shown, given what answers it and the window it belongs to, which a test answers for itself.
    ask_open: &Fn(@keeps &Fn(DialogResult) -> unit, Option[&Window]) -> unit
    ask_save: &Fn(@keeps &Fn(DialogResult) -> unit, Option[&Window]) -> unit
    ask_export_stl: &Fn(@keeps &Fn(DialogResult) -> unit, Option[&Window]) -> unit
    ask_export_3mf: &Fn(@keeps &Fn(DialogResult) -> unit, Option[&Window]) -> unit

    // Whether the next frame takes the keyboard from whichever field has it.
    release_keyboard: bool

    // The window the question and the dialogs belong to, and how it is retitled, which a test answers for itself.
    parent: &Fn() -> Option[&Window]
    retitle: &Fn(string) -> bool

    // The title the window was last given.
    titled: string

    // Whether this frame has already asked about quitting. Closing the window sends two events, and the second
    // must not ask again after the first was answered.
    quit_asked: bool

    // The printer the bed and the build volume are drawn for, and whether the volume's outline shows.
    printer: Printer
    show_volume: bool

    // Whether the array panel is up, which of `ARRAY_KINDS` it has chosen, and what is typed into its fields. The
    // fields keep what was typed from one array to the next.
    array_open: &Signal[bool]
    array_kind: &Signal[int]
    array_count: &Signal[string]
    array_spacing: &Signal[string]
    array_angle: &Signal[string]

    // Whether the selection's sizes and gaps show over the viewport, and what they were as last painted.
    show_dimensions: bool
    measured: &Measures

    // Whether the hollow panel is up, what is typed into its wall field, and which of `HOLLOW_TOPS` it has chosen.
    hollow_open: &Signal[bool]
    hollow_wall: &Signal[string]
    hollow_top: &Signal[int]

    private changed(&self) = self.changes.set(self.changes.read() + 1)

    // Whether something is over the viewport that the pointer belongs to instead.
    private covered(&self) -> bool =
        self.open_menu.read() != NO_MENU || self.in_dialog.read() || self.array_open.read() || self.hollow_open.read()

    // Ask first if this would lose anything, and otherwise do it. A drag or an open dialog finishes first.
    private guarded(&self, intent: Intent)
        if self.is_editing() || self.in_dialog.read() then return

        self.open_menu.set(NO_MENU)

        if !self.doc.is_dirty() then return self.carry_out(intent)

        self.release_keyboard = true

        unsaved_answer((self.ask_changes)(question_title(self.file), (self.parent)())) match
            SaveFirst -> self.save(Some(intent))
            Discard -> self.carry_out(intent)
            Stay(why) -> if why != "" then self.problem.set(why)

        self.changed()
    end guarded

    // Once a frame: the window's title follows the file and its unsaved mark, and a close may be asked about again.
    next_frame(&self)
        self.quit_asked = false

        val t = self.title()

        if t != self.titled && (self.retitle)(t) then self.titled = t
    end next_frame

    // What the window is called now.
    title(&self) -> string = window_title(self.file, self.doc.is_dirty())

    private carry_out(&self, intent: Intent)
        intent match
            NewDocument -> self.take_document(new_document(self.doc.next_revision), "")
            OpenDocument -> self.show_dialog(self.ask_open, Asked.Opening)
            Quit -> (self.quit)()
    end carry_out

    private go_on(&self, after: Option[Intent])
        after match
            Some(intent) -> self.carry_out(intent)
            None -> ()
    end go_on

    private show_dialog(&self, show: &Fn(@keeps &Fn(DialogResult) -> unit, Option[&Window]) -> unit, asked: Asked)
        val answer: &Fn(DialogResult) -> unit = r -> self.dialog_answered(asked, r)

        self.in_dialog.set(true)
        show(answer, (self.parent)())
    end show_dialog

    private dialog_answered(&self, asked: Asked, r: DialogResult)
        self.in_dialog.set(false)

        asked match
            Opening ->
                open_answer(r) match
                    Stay -> ()
                    Report(why) -> self.problem.set(why)
                    Use(file) -> self.open_path(file)
            SavingAs(after) ->
                save_answer(r) match
                    Stay -> ()
                    Report(why) -> self.problem.set(why)
                    Use(file) -> if self.write_to(file) then self.go_on(after)
            ExportingStl ->
                export_answer(r, "stl") match
                    Stay -> ()
                    Report(why) -> self.problem.set(why)
                    Use(file) -> self.export_to(file)
            Exporting3mf ->
                export_answer(r, "3mf") match
                    Stay -> ()
                    Report(why) -> self.problem.set(why)
                    Use(file) -> self.export_3mf_to(file)

        self.changed()
    end dialog_answered

    // Everything about the old document goes with it: what it held, what was being typed about it.
    private take_document(&self, doc: &Document, file: string)
        self.doc = doc
        self.file = file
        self.camera.frame(doc)
        self.gesture = Gesture.Idle
        self.carried = buf()
        self.problem.set("")

        for field in self.fields.view() do field.forget()

        self.release_keyboard = true
        self.changed()
    end take_document

    // The file menu's commands.
    new_file(&self) = self.guarded(Intent.NewDocument)

    open_file(&self) = self.guarded(Intent.OpenDocument)

    // Quit, asking first; a second request in the same frame is the same close, and asks nothing.
    request_quit(&self)
        if self.quit_asked then return

        self.quit_asked = true
        self.guarded(Intent.Quit)
    end request_quit

    // Quit at once, asking nothing, whatever is unsaved: for a session driven over its control socket, which has
    // nobody to answer the question.
    quit_now(&self) = (self.quit)()

    // Save to the file this document has, and without one ask where.
    save(&self, after: Option[Intent] = None)
        if self.is_editing() || self.in_dialog.read() then return

        if self.file == ""
            self.save_as(after)
        elif self.write_to(self.file)
            self.go_on(after)
    end save

    save_as(&self, after: Option[Intent] = None)
        if self.is_editing() || self.in_dialog.read() then return

        self.show_dialog(self.ask_save, Asked.SavingAs(after))
    end save_as

    // Says whether the document is now in that file, and if not the panel says why.
    private write_to(&self, file: string) -> bool
        val done = save_file(self.doc, file)

        done match
            Ok(_) ->
                self.file = file
                self.problem.set("")
            Err(why) -> self.problem.set(s"Could not save ${name_of(file)}: ${why}")

        self.changed()
        done.is_ok()
    end write_to

    // Ask where to write the document's solid as STL. A document with no solid to send says why at once, rather
    // than after a dialog. An export is not a save: the document keeps its file and its mark.
    export_stl_file(&self)
        if self.is_editing() || self.in_dialog.read() then return

        self.open_menu.set(NO_MENU)

        self.doc.final_solid() match
            Ok(_) -> self.show_dialog(self.ask_export_stl, Asked.ExportingStl)
            Err(why) ->
                self.problem.set(s"Could not export: ${why}")
                self.changed()
    end export_stl_file

    private export_to(&self, file: string)
        export_stl(self.doc, file) match
            Ok(_) -> self.problem.set("")
            Err(why) -> self.problem.set(s"Could not export ${name_of(file)}: ${why}")
    end export_to

    // Ask where to write the document's solid as 3MF, as `export_stl_file` does for STL.
    export_3mf_file(&self)
        if self.is_editing() || self.in_dialog.read() then return

        self.open_menu.set(NO_MENU)

        self.doc.final_solid() match
            Ok(_) -> self.show_dialog(self.ask_export_3mf, Asked.Exporting3mf)
            Err(why) ->
                self.problem.set(s"Could not export: ${why}")
                self.changed()
    end export_3mf_file

    private export_3mf_to(&self, file: string)
        export_3mf(self.doc, file, self.printer) match
            Ok(_) -> self.problem.set("")
            Err(why) -> self.problem.set(s"Could not export ${name_of(file)}: ${why}")
    end export_3mf_to

    // Replace the document with this file's, or say why not and leave everything as it is.
    open_path(&self, file: string) -> bool
        load_file(file, self.doc.next_revision) match
            Ok(doc) ->
                self.take_document(doc, file)
                true
            Err(why) ->
                self.problem.set(s"Could not open ${name_of(file)}: ${why}")
                self.changed()
                false
    end open_path

    // The palette's command, and what the view does about it.
    add(&self, p: Primitive)
        self.doc.add_shape(p)
        self.camera.frame_if_out_of_view(self.doc)
        self.problem.set("")
        self.changed()
    end add

    // Report how a command went. A command in the middle of a drag would be undone or overtaken by the drag, so
    // nothing asks for one then.
    private answer(&self, done: Result[unit, string])
        done match
            Ok(_) -> self.problem.set("")
            Err(why) -> self.problem.set(why)

        self.changed()
    end answer

    set_hole(&self, hole: bool) = if !self.is_editing() then self.answer(self.doc.set_hole(hole))

    // Rounds or chamfers the selected box's or cylinder's edges.
    set_edge_chamfer(&self, chamfer: bool)
        if self.is_editing() then return

        self.answer(self.doc.selected.ok_or("Nothing is selected").and_then(id -> self.doc.set_edge_chamfer(id, chamfer)))

    group(&self) = if !self.is_editing() then self.answer(self.doc.group_selected().map(id -> ()))

    // Groups the selection as an intersection: only what all of its solids share.
    intersect(&self) = if !self.is_editing() then self.answer(self.doc.group_selected(intersect = true).map(id -> ()))

    // Whether the selected group joins its solids or keeps only what they share.
    set_group_mode(&self, intersect: bool)
        if self.is_editing() then return

        self.answer(self.doc.selected.ok_or("Nothing is selected").and_then(id -> self.doc.set_group_mode(id, intersect)))

    // Whether the selected hollow solid is open at its top.
    set_open_top(&self, open: bool)
        if self.is_editing() then return

        self.answer(self.doc.selected.ok_or("Nothing is selected").and_then(id -> self.doc.set_open_top(id, open)))

    split(&self, axis: int) = if !self.is_editing() then self.answer(self.doc.split_selected(axis))

    // Put up the hollow panel over everything, with nothing typing anywhere else.
    open_hollow(&self)
        if self.is_editing() then return

        self.open_menu.set(NO_MENU)

        if !self.doc.can_hollow() then return self.answer(Err("Only a solid can be hollowed"))

        self.release_keyboard = true
        self.problem.set("")
        self.hollow_open.set(true)
        self.changed()
    end open_hollow

    // Take the hollow panel down and leave the document as it was.
    cancel_hollow(&self)
        self.release_keyboard = true
        self.problem.set("")
        self.hollow_open.set(false)
        self.changed()
    end cancel_hollow

    // The hollow panel's OK: each selected solid made a shell. A wall that is no number, or one the document
    // refuses, keeps the panel up and says why.
    accept_hollow(&self)
        val typed = self.hollow_wall.read()
        val made = parse_real(typed).map_err(e -> s"\"${typed}\" is not a number")
            .and_then(wall -> self.doc.hollow_selected(wall, self.hollow_top.read() == 1))

        made match
            Ok(_) ->
                self.release_keyboard = true
                self.hollow_open.set(false)
            Err(_) -> ()

        self.answer(made)
    end accept_hollow

    ungroup(&self) = if !self.is_editing() then self.answer(self.doc.ungroup_selected())

    delete(&self) = if !self.is_editing() then self.answer(self.doc.delete_selected())

    mirror(&self, axis: int) = if !self.is_editing() then self.answer(self.doc.mirror_selected(axis))

    align(&self, axis: int, edge: Edge) = if !self.is_editing() then self.answer(self.doc.align_selected(axis, edge))

    drop_to_bed(&self) = if !self.is_editing() then self.answer(self.doc.drop_selected())

    // A copy of the selection one grid step to the right, selected.
    duplicate(&self) = if !self.is_editing() then self.answer(self.doc.duplicate_selected(self.grid))

    // Put up the array panel over everything, with nothing typing anywhere else.
    open_array(&self)
        if self.is_editing() then return

        self.open_menu.set(NO_MENU)

        if self.doc.selection.len() == 0 then return self.answer(Err("Nothing is selected"))

        self.release_keyboard = true
        self.problem.set("")
        self.array_open.set(true)
        self.changed()
    end open_array

    // Take the panel down and leave the document as it was.
    cancel_array(&self)
        self.release_keyboard = true
        self.problem.set("")
        self.array_open.set(false)
        self.changed()
    end cancel_array

    // The panel's OK: the array its fields ask for. A count or a step that is no number, or one the document
    // refuses, keeps the panel up and says why.
    accept_array(&self)
        val made = self.array_from_fields().and_then(a -> self.doc.array_selected(a.0, a.1))

        made match
            Ok(_) ->
                self.release_keyboard = true
                self.array_open.set(false)
            Err(_) -> ()

        self.answer(made)
    end accept_array

    // The count and the pattern the panel's fields ask for.
    private array_from_fields(&self) -> Result[(int, Pattern), string]
        val typed = self.array_count.read()
        val count = parse_real(typed).map_err(e -> s"\"${typed}\" is not a number")?

        // Held to what an int holds; the document holds it to what an array may make.
        if !count.is_finite() || count != count.round() then return Err("Copies must be a whole number")

        val kind = self.array_kind.read()
        val text = if kind >= FIRST_RING then self.array_angle.read() else self.array_spacing.read()
        val step = parse_real(text).map_err(e -> s"\"${text}\" is not a number")?
        val pattern = if kind >= FIRST_RING then Pattern.Ring(kind > FIRST_RING, step) else Pattern.Line(kind, step)

        Ok((int(count.clamp(-1.0e6, 1.0e6)), pattern))
    end array_from_fields

    undo(&self)
        if !self.is_editing()
            self.doc.undo()
            self.answer(Ok(()))
    end undo

    redo(&self)
        if !self.is_editing()
            self.doc.redo()
            self.answer(Ok(()))
    end redo

    // Bring everything in the document into view.
    frame_all(&self)
        self.camera.frame(self.doc)
        self.changed()
    end frame_all

    // Show the build volume's outline if it is hidden, and hide it if it shows.
    toggle_volume(&self)
        self.show_volume = !self.show_volume
        self.changed()

    // Show the selection's sizes and gaps if they are hidden, and hide them if they show.
    toggle_dimensions(&self)
        self.show_dimensions = !self.show_dimensions
        self.changed()

    // What goes over the viewport for the selection, through the camera as it is, in a viewport this many points
    // across: the handles, with the gaps' lines added to their strokes where dimensions show. `hot` is the
    // handle under the pointer.
    private lay_out(&self, w: real, h: real, hot: Option[Grip] = None)
        self.overlay = layout(self.doc, self.camera, w, h, hot)
        self.measured = if self.show_dimensions then measures(self.doc, self.camera, w, h) else Measures(buf(), buf())

        for s in self.measured.strokes.view() do self.overlay.strokes.push(s)
    end lay_out

    // A key the toolkit does not see, as the window reports it: `code` is the layout's own, so the letters are
    // where the keyboard has them. Says whether it was a shortcut, and so whether anyone else should see it.
    shortcut(&self, code: u32, mods: u16, repeat: bool) -> bool
        if self.in_dialog.read() then return true

        if (mods & KMOD_GUI) == 0u16 || self.typing then return false

        // The array and hollow panels are answered before anything else is asked for.
        if self.array_open.read() || self.hollow_open.read() then return true

        val shift = (mods & KMOD_SHIFT) != 0u16

        if code == u32(u8('n')) || code == u32(u8('o')) || code == u32(u8('s'))
            if !repeat
                if code == u32(u8('n'))
                    self.new_file()
                elif code == u32(u8('o'))
                    self.open_file()
                elif shift
                    self.save_as()
                else
                    self.save()

            return true

        if code == u32(u8('z'))
            if shift then self.redo() else self.undo()

            return true

        if code == u32(u8('g'))
            if !repeat
                if shift then self.ungroup() else self.group()

            return true

        if code == u32(u8('i')) && shift
            if !repeat then self.intersect()

            return true

        if code == u32(u8('b'))
            if !repeat then self.drop_to_bed()

            return true

        if code == u32(u8('d'))
            if !repeat then self.duplicate()

            return true

        false
    end shortcut

    // A click at this point of a viewport at this rectangle. On a handle it does nothing: the handle is
    // part of what is already selected. With `adding` it joins the selection or leaves it, and a click on
    // nothing changes nothing, so a slip does not lose what has been gathered.
    click(&self, x: int, y: int, r: Rect, adding: bool = false)
        val lx = real(x - r.x)
        val ly = real(y - r.y)

        if layout(self.doc, self.camera, real(r.w), real(r.h)).grip_at(lx, ly).is_some() then return

        val ray = self.camera.ray(lx, ly, real(r.w), real(r.h))

        pick(self.doc, ray) match
            Some(id) -> if adding then self.doc.toggle_selected(id) else self.doc.select(Some(id))
            None -> if !adding then self.doc.select(None)

        self.problem.set("")
        self.changed()
    end click

    // A drag has just begun at this point. A handle of the selection comes first, whatever stands in front
    // of it, then the nearest shape, which it selects, and failing both the view.
    private begin(&self, x: int, y: int, r: Rect)
        val lx = real(x - r.x)
        val ly = real(y - r.y)
        val w = real(r.w)
        val h = real(r.h)

        layout(self.doc, self.camera, w, h).grip_at(lx, ly) match
            Some(grip) ->
                self.doc.selected.and_then(id -> drag_grip(self.doc, self.camera, id, grip, w, h, lx, ly)) match
                    Some(d) -> self.start_edit(d)
                    None -> ()

                return
            None -> ()

        val ray = self.camera.ray(lx, ly, w, h)

        pick_hit(self.doc, ray) match
            Some(p) ->
                // A drag on part of a selection takes all of it along, and on anything else takes that alone.
                if !self.doc.is_selected(p.id) then self.doc.select(Some(p.id))

                self.problem.set("")
                self.changed()

                drag_body(self.doc, p.id, ray.at(p.distance), lx, ly) match
                    Some(d) -> self.start_edit(d)
                    None -> ()
            None -> self.gesture = Gesture.Orbit
    end begin

    // However many frames it takes, a drag is one undo step.
    private start_edit(&self, d: Drag)
        var carried: Buf[(int, Transform)] = buf()

        for id in self.doc.selection.view()
            if id != d.id
                self.doc.find(id) match
                    Some(node) -> carried.push((id, node.transform))
                    None -> ()

        self.carried = carried
        self.gesture = Gesture.Edit(d)
        self.doc.begin_step()
    end start_edit

    // Bring the shape to where the pointer has it now, and whatever it carries by as much. Nothing is told if
    // that is where it already is, so a pointer held still costs no rebuild.
    private follow(&self, d: Drag, c: *Canvas, r: Rect)
        val (x, y) = c.pointer()
        val keys = c.modifiers()
        val t = d.transform_at(self.camera, real(r.w), real(r.h), real(x - r.x), real(y - r.y),
                               DragKeys(self.grid, keys.shift, keys.alt))

        self.doc.find(d.id) match
            Some(node) ->
                if node.transform != t
                    self.doc.set_transform(d.id, t)

                    val by = t.translation - d.start.translation

                    for (id, was) in self.carried.view()
                        self.doc.set_transform(id, Transform(was.translation + by, was.rotation, was.scale))

                    self.changed()
            None -> ()
    end follow

    is_editing(&self) -> bool =
        self.gesture match
            Edit(_) -> true
            _ -> false

    // What the pointer did over the viewport this frame.
    //
    // **While a menu is open the viewport hears none of it.** What is raised over the viewport takes taps from
    // it, but a drag and the wheel are read here by position, so a wobble on a row of a menu would turn the view
    // and the wheel over a menu would zoom it. A file dialog is the same.
    private input(&self, c: *Canvas, r: Rect)
        self.width = r.w
        self.height = r.h

        if self.release_keyboard
            self.release_keyboard = false
            c.take_focus(NOBODY)

        if self.covered() && c.held(PointerButton.Primary) then self.menu_press = true
        if !c.held(PointerButton.Primary) then self.menu_press = false

        if self.covered() || self.menu_press
            self.typing = c.focus() != NOBODY

            // Return answers the array panel as OK does and Escape as Cancel does.
            if self.array_open.read()
                for p in c.keys()
                    if p.key == Key.Enter then self.accept_array()
                    if p.key == Key.Escape then self.cancel_array()

            if self.hollow_open.read()
                for p in c.keys()
                    if p.key == Key.Enter then self.accept_hollow()
                    if p.key == Key.Escape then self.cancel_hollow()

            self.lay_out(real(r.w), real(r.h))

            return

        val (ox, oy) = c.drag_by(r, 1, PointerButton.Primary, CLICK_SLOP, CLICK_SLOP)

        if ox != 0 || oy != 0
            self.gesture match
                Idle ->
                    val (bx, by) = c.press_origin()

                    self.begin(bx, by, r)
                _ -> ()

        self.gesture match
            Idle -> ()
            Orbit -> if ox != 0 || oy != 0 then self.camera.orbit(real(ox), real(oy))
            Edit(d) -> self.follow(d, c, r)

        // The other buttons and the wheel are still read while a shape is being dragged, so they are taken
        // from whatever would have them, and do nothing: the view holding still is what keeps the shape
        // under the pointer.
        for button in [PointerButton.Middle, PointerButton.Secondary]
            val (px, py) = c.drag_by(r, 2, button, 0, 0)

            if (px != 0 || py != 0) && !self.is_editing() then self.camera.pan(real(px), real(py), real(r.h))

        val (_, wheel) = c.wheel(r)

        if wheel != 0 && !self.is_editing() then self.camera.zoom(real(wheel))

        if !c.held(PointerButton.Primary)
            if self.is_editing()
                self.doc.end_step()
                self.changed()

            self.gesture = Gesture.Idle

        // A tap's action is called at the release, between paints, with no canvas to ask where the press
        // was; the next paint asks, and the press may have come and gone since this one.
        if self.tap_waiting
            val (x, y) = c.press_origin()

            self.tap_waiting = false
            self.click(x, y, r, c.modifiers().shift)

        c.hit(r, () -> self.tap_waiting = true)

        self.typing = c.focus() != NOBODY

        if !self.typing
            for p in c.keys()
                if p.key == Key.Delete || p.key == Key.Backspace
                    if self.doc.selection.len() > 0 then self.delete()

        self.lay_out(real(r.w), real(r.h), self.hot_grip(c, r))
    end input

    // The handle to show as being under the pointer: the one being dragged, or else whatever is there.
    private hot_grip(&self, c: *Canvas, r: Rect) -> Option[Grip]
        self.gesture match
            Edit(d) -> return d.grip
            Orbit -> return None
            Idle -> ()

        val (x, y) = c.pointer()

        if !r.holds(x, y) then return None

        layout(self.doc, self.camera, real(r.w), real(r.h)).grip_at(real(x - r.x), real(y - r.y))
    end hot_grip

    // The viewport, made once: it holds the targets the 3D is drawn into.
    viewport(&self) -> &Viewport
        self.view match
            Some(v) -> return v
            None -> ()

        val v = viewport(f ->
            val scale = if self.height > 0 then real(f.rect.h) / real(self.height) else 1.0

            self.renderer.draw(f.device, f.cmd, f.color, f.depth, viewport_depth_format(f.device), VIEWPORT_COLOR_FORMAT,
                               self.doc, self.camera, real(f.rect.w), real(f.rect.h), scale, self.overlay.strokes.view(),
                               self.printer, self.show_volume)
        , (c, r) -> self.input(c, r))

        self.view = Some(v)
        v
    end viewport

    // The viewport with the selection's marks over it.
    dimensioned(&self) -> &Dimensioned = Dimensioned(self, self.viewport())

    // The whole window.
    tree(&self) -> &View
        self.changes.read()

        val menus = self.menus()

        column([menu_bar(menus.view(), self.open_menu).restyle(t -> light()),
                row([self.panel(), self.dimensioned().flex()]).flex()], 0)
            .modal(self.array_open, self.array_panel())
            .modal(self.hollow_open, self.hollow_panel())
            .modal(self.in_dialog, spacer().frame(0, 0))
    end tree

    // The array panel: what kind of array, how many copies, how far apart, and OK or Cancel.
    private array_panel(&self) -> &View
        val kind = self.array_kind.read()
        val ring = kind >= FIRST_RING
        var parts: Buf[&View] = buf()

        parts.push(text("Array").font_size(16.0))

        for i in 0..<ARRAY_KINDS.len do parts.push(radio(self.array_kind, int(i), ARRAY_KINDS[i]).named(s"array.kind.${i}"))

        parts.push(text("Copies").font_size(11.0))
        parts.push(text_field(self.array_count, ARRAY_COUNT_ID, NUMBER_WIDTH).font_size(11.0).named("array.count"))

        if ring
            parts.push(text("Angle between copies, degrees").font_size(11.0))
            parts.push(text_field(self.array_angle, ARRAY_ANGLE_ID, NUMBER_WIDTH).font_size(11.0).named("array.angle"))
        else
            parts.push(text("Spacing, mm").font_size(11.0))
            parts.push(text_field(self.array_spacing, ARRAY_SPACING_ID, NUMBER_WIDTH).font_size(11.0)
                .named("array.spacing"))

        for line in split(wrapped(self.problem.read(), PROBLEM_ROOM), "\n")
            if line != "" then parts.push(text(line).font_size(11.0).foreground(WRONG_INK))

        parts.push(row([button("Cancel", () -> self.cancel_array(), Role.Primary, Variant.Soft).named("array.cancel").flex(),
                        button("OK", () -> self.accept_array(), Role.Primary, Variant.Filled).named("array.ok").flex()], 6))

        column(parts.view(), 6).padding(16).background(0xFFFFFFu32, 8).border(0xCBD2DCu32, 1, 8).restyle(t -> light())
    end array_panel

    // The hollow panel: how thick the walls are, closed or open at the top, and OK or Cancel.
    private hollow_panel(&self) -> &View
        var parts: Buf[&View] = buf()

        parts.push(text("Hollow").font_size(16.0))
        parts.push(text(s"Wall, mm (${MIN_WALL} to ${MAX_WALL.round()})").font_size(11.0))
        parts.push(text_field(self.hollow_wall, HOLLOW_WALL_ID, NUMBER_WIDTH).font_size(11.0).named("hollow.wall"))

        for i in 0..<HOLLOW_TOPS.len do parts.push(radio(self.hollow_top, int(i), HOLLOW_TOPS[i]).named(s"hollow.top.${i}"))

        for line in split(wrapped(self.problem.read(), PROBLEM_ROOM), "\n")
            if line != "" then parts.push(text(line).font_size(11.0).foreground(WRONG_INK))

        parts.push(row([button("Cancel", () -> self.cancel_hollow(), Role.Primary, Variant.Soft).named("hollow.cancel").flex(),
                        button("OK", () -> self.accept_hollow(), Role.Primary, Variant.Filled).named("hollow.ok").flex()], 6))

        column(parts.view(), 6).padding(16).background(0xFFFFFFu32, 8).border(0xCBD2DCu32, 1, 8).restyle(t -> light())
    end hollow_panel

    // The menus, each row live only where its command would do something now.
    private menus(&self) -> Buf[Menu]
        val doc = self.doc
        var all: Buf[Menu] = buf()

        all.push(menu("File", [item("New", () -> self.new_file(), "Cmd+N"),
                               item("Open", () -> self.open_file(), "Cmd+O"),
                               item("Save", () -> self.save(), "Cmd+S"),
                               item("Save As", () -> self.save_as(), "Cmd+Shift+S"),
                               separator(),
                               item("Export STL…", () -> self.export_stl_file()),
                               item("Export 3MF…", () -> self.export_3mf_file()),
                               separator(),
                               item("Quit", () -> self.request_quit())]))
        all.push(menu("Edit", [item("Undo", () -> self.undo(), "Cmd+Z", enabled = doc.can_undo),
                               item("Redo", () -> self.redo(), "Cmd+Shift+Z", enabled = doc.can_redo),
                               separator(),
                               item("Delete", () -> self.delete(), "Delete", enabled = doc.can_delete),
                               item("Duplicate", () -> self.duplicate(), "Cmd+D", enabled = doc.can_arrange),
                               separator(),
                               item("Group", () -> self.group(), "Cmd+G", enabled = doc.can_group()),
                               item("Ungroup", () -> self.ungroup(), "Cmd+Shift+G", enabled = doc.can_ungroup()),
                               item("Intersect", () -> self.intersect(), "Cmd+Shift+I", enabled = doc.can_group()),
                               separator(),
                               item("Solid", () -> self.set_hole(false), enabled = doc.can_set_hole(false)),
                               item("Hole", () -> self.set_hole(true), enabled = doc.can_set_hole(true))]))
        all.push(menu("Arrange", [item("Mirror X", () -> self.mirror(0), enabled = doc.can_arrange),
                                  item("Mirror Y", () -> self.mirror(1), enabled = doc.can_arrange),
                                  item("Mirror Z", () -> self.mirror(2), enabled = doc.can_arrange),
                                  separator(),
                                  item("Align Left", () -> self.align(0, Edge.Min), enabled = doc.can_align),
                                  item("Align Centre X", () -> self.align(0, Edge.Centre), enabled = doc.can_align),
                                  item("Align Right", () -> self.align(0, Edge.Max), enabled = doc.can_align),
                                  item("Align Front", () -> self.align(1, Edge.Min), enabled = doc.can_align),
                                  item("Align Centre Y", () -> self.align(1, Edge.Centre), enabled = doc.can_align),
                                  item("Align Back", () -> self.align(1, Edge.Max), enabled = doc.can_align),
                                  item("Align Bottom", () -> self.align(2, Edge.Min), enabled = doc.can_align),
                                  item("Align Centre Z", () -> self.align(2, Edge.Centre), enabled = doc.can_align),
                                  item("Align Top", () -> self.align(2, Edge.Max), enabled = doc.can_align),
                                  separator(),
                                  item("Drop to Bed", () -> self.drop_to_bed(), "Cmd+B", enabled = doc.can_arrange),
                                  separator(),
                                  item("Array…", () -> self.open_array(), enabled = doc.can_arrange),
                                  item("Hollow…", () -> self.open_hollow(), enabled = doc.can_hollow()),
                                  separator(),
                                  item("Split X", () -> self.split(0), enabled = doc.can_arrange),
                                  item("Split Y", () -> self.split(1), enabled = doc.can_arrange),
                                  item("Split Z", () -> self.split(2), enabled = doc.can_arrange)]))
        all.push(menu("View", [item("Frame All", () -> self.frame_all(), enabled = doc.items().len > 0),
                               toggle("Build Volume", () -> self.toggle_volume(), self.show_volume),
                               toggle("Dimensions", () -> self.toggle_dimensions(), self.show_dimensions)]))
        all
    end menus

    // Open the menu of this title. Says whether there is one.
    show_menu(&self, title: string) -> bool
        val all = self.menus().view()

        for i in 0..<all.len
            if all[i].title == title
                self.open_menu.set(int(i))

                return true

        false
    end show_menu

    private panel(&self) -> &View
        var parts: Buf[&View] = buf()

        parts.push(text("Tekton").font_size(22.0))

        if self.file != "" then parts.push(text(shortened(name_of(self.file))).font_size(11.0))

        parts.push(text("Shapes"))

        for p in PRIMITIVES
            parts.push(button(primitive_name(p), () -> self.add(p), Role.Primary, Variant.Soft)
                .named(s"palette.${to_lower(primitive_name(p))}"))

        parts.push(row([self.small_button("Undo", () -> self.undo(), "undo", self.doc.can_undo).flex(),
                        self.small_button("Redo", () -> self.redo(), "redo", self.doc.can_redo).flex()], 6))
        parts.push(spacer().flex())
        parts.push(self.selection_panel())

        for line in split(wrapped(self.problem.read(), PROBLEM_ROOM), "\n")
            if line != "" then parts.push(text(line).font_size(11.0).foreground(WRONG_INK))

        parts.push(column([text("Drag a shape to move it").font_size(11.0), text("Drag empty space to orbit").font_size(11.0),
                           text("Right-drag to pan, wheel to zoom").font_size(11.0),
                           text("Shift-click to select several").font_size(11.0),
                           text("Shift: no snapping").font_size(11.0),
                           text("Option: keep proportions").font_size(11.0),
                           text("Cmd+G group, Cmd+Z undo").font_size(11.0)], 2))

        row([column(parts.view(), 10).padding(16).frame(206, 0).background(0xFFFFFFu32).restyle(t -> light()),
             spacer().frame(1, 0).background(0xCBD2DCu32)])
    end panel

    // The nine number fields, the segments field, the clearance field, the edge radius field and the wall field, made once,
    // because each remembers what is being typed in it.
    number_fields(&self) -> []const &NumberField
        if self.fields.len() == 0
            for q in [Quantity.Position, Quantity.Size, Quantity.Rotation]
                for axis in 0..<3
                    val id = FIRST_FIELD_ID + int(self.fields.len())

                    self.fields.push(new_number_field(self, q, axis, id))

            for q in [Quantity.Segments, Quantity.Clearance, Quantity.EdgeRadius, Quantity.Wall]
                self.fields.push(new_number_field(self, q, 0, FIRST_FIELD_ID + int(self.fields.len())))

        self.fields.view()
    end number_fields

    // A button that says whether it has anything to do: dashed when it has not. There is no disabled state to
    // ask for, so a tap on one with nothing to do is a tap that does nothing.
    private small_button(&self, label: string, tap: &Fn() -> unit, name: string, live: bool) -> &View =
        button(label, tap, Role.Primary, if live then Variant.Soft else Variant.Dashed).named(name)

    // Which of the two is on: filled, and the other quiet. With a mixed selection neither is.
    private solid_or_hole(&self) -> &View
        var solids = 0
        var holes = 0

        for id in self.doc.selection.view()
            self.doc.find(id) match
                Some(node) -> if node.hole then holes += 1 else solids += 1
                None -> ()

        row([button("Solid", () -> self.set_hole(false), Role.Primary,
                    if holes == 0 then Variant.Filled else Variant.Outline).named("panel.solid").flex(),
             button("Hole", () -> self.set_hole(true), Role.Primary,
                    if solids == 0 then Variant.Filled else Variant.Outline).named("panel.hole").flex()], 6)
    end solid_or_hole

    // Which finish a box's edges or a cylinder's rims take: filled, and the other quiet.
    private round_or_chamfer(&self, chamfer: bool) -> &View =
        row([button("Round", () -> self.set_edge_chamfer(false), Role.Primary,
                    if chamfer then Variant.Outline else Variant.Filled).named("panel.edge.round").flex(),
             button("Chamfer", () -> self.set_edge_chamfer(true), Role.Primary,
                    if chamfer then Variant.Filled else Variant.Outline).named("panel.edge.chamfer").flex()], 6)

    // Whether a group joins its solids or keeps only what they share: filled, and the other quiet.
    private union_or_intersect(&self, intersect: bool) -> &View =
        row([button("Union", () -> self.set_group_mode(false), Role.Primary,
                    if intersect then Variant.Outline else Variant.Filled).named("panel.union").flex(),
             button("Intersect", () -> self.set_group_mode(true), Role.Primary,
                    if intersect then Variant.Filled else Variant.Outline).named("panel.intersect").flex()], 6)

    // Whether a hollow solid is closed or open at its top: filled, and the other quiet.
    private closed_or_open(&self, open: bool) -> &View =
        row([button("Closed", () -> self.set_open_top(false), Role.Primary,
                    if open then Variant.Outline else Variant.Filled).named("panel.closed").flex(),
             button("Open top", () -> self.set_open_top(true), Role.Primary,
                    if open then Variant.Filled else Variant.Outline).named("panel.open_top").flex()], 6)

    private selection_panel(&self) -> &View
        val count = self.doc.selection.len()

        if count == 0 then return text("Nothing selected").font_size(12.0)

        var parts: Buf[&View] = buf()

        self.doc.selected.and_then(id -> self.doc.find(id)) match
            Some(node) ->
                val name = node.operation match
                    Shape(p, _, _) -> primitive_name(p)
                    Group(i) -> if i then "Intersection" else "Group"
                val fields = self.number_fields()

                parts.push(text(name).font_size(16.0))
                parts.push(self.solid_or_hole())

                for (i, label) in [(0, "Position, mm"), (3, "Size, mm"), (6, "Rotation, degrees")]
                    parts.push(text(label).font_size(11.0))
                    parts.push(row([fields[i].view(), fields[i + 1].view(), fields[i + 2].view()], 3))

                if node.segments.is_some()
                    parts.push(text("Segments").font_size(11.0))
                    parts.push(row([fields[9].view().named("panel.segments")], 3))

                if node.hole && node.takes_clearance
                    parts.push(text("Clearance, mm").font_size(11.0))
                    parts.push(row([fields[10].view().named("panel.clearance")], 3))

                node.edges match
                    Some(e) ->
                        parts.push(text("Edge radius, mm").font_size(11.0))
                        parts.push(row([fields[11].view().named("panel.edge_radius")], 3))
                        parts.push(text("Edge").font_size(11.0))
                        parts.push(self.round_or_chamfer(e.chamfer))
                    None -> ()

                if node.is_group then parts.push(self.union_or_intersect(node.intersects))

                if node.is_hollow
                    parts.push(text("Wall, mm").font_size(11.0))
                    parts.push(row([fields[12].view().named("panel.wall")], 3))
                    parts.push(self.closed_or_open(node.shell.open))

                if node.is_group
                    parts.push(row([self.small_button("Ungroup", () -> self.ungroup(), "panel.ungroup", true).flex(),
                                    self.small_button("Delete", () -> self.delete(), "panel.delete", true).flex()], 6))
                else
                    parts.push(self.small_button("Delete", () -> self.delete(), "panel.delete", true))
            None ->
                parts.push(text(s"${count} selected").font_size(16.0))
                parts.push(self.solid_or_hole())
                parts.push(row([self.small_button("Group", () -> self.group(), "panel.group", true).flex(),
                                self.small_button("Delete", () -> self.delete(), "panel.delete", true).flex()], 6))

        column(parts.view(), 4)
    end selection_panel

    // What a field should show now.
    private number(&self, q: Quantity, axis: int) -> Option[real]
        val node = self.doc.selected.and_then(id -> self.doc.find(id))?

        Some(q match
            Position -> node.transform.translation.axis(axis)
            Size -> self.doc.size_of(node).axis(axis)
            Rotation -> euler_degrees(node.transform.rotation)[axis]
            Segments -> real(node.segments?)
            Clearance -> node.clearance
            EdgeRadius -> node.edges?.radius
            Wall -> node.shell.wall)
    end number

    // The command behind a number typed into a field.
    private put(&self, q: Quantity, axis: int, value: real) -> Result[unit, string]
        val id = self.doc.selected.ok_or("nothing selected")?
        val node = self.doc.find(id).ok_or("nothing selected")?

        val done = q match
            Position -> self.doc.move_to(id, node.transform.translation.with_axis(axis, value))
            Size -> self.doc.resize_to(id, self.doc.size_of(node).with_axis(axis, value))
            Segments ->
                if !value.is_finite() || value != value.round()
                    Err("Segments must be a whole number")
                else
                    // Held to what an int holds; the document holds it to what a shape may have.
                    self.doc.set_segments(id, int(value.clamp(-1.0e6, 1.0e6)))
            Clearance -> self.doc.set_clearance(id, value)
            EdgeRadius -> self.doc.set_edge_radius(id, value)
            Wall -> self.doc.set_wall(id, value)
            Rotation ->
                if !value.is_finite()
                    Err("Rotation must be a number of degrees")
                else
                    var angles = euler_degrees(node.transform.rotation)

                    angles[axis] = value
                    self.doc.rotate_to(id, Quaternion.from_euler(angles[2] * RADIANS_PER_DEGREE,
                                                                 angles[1] * RADIANS_PER_DEGREE,
                                                                 angles[0] * RADIANS_PER_DEGREE))

        done?
        self.changed()
        Ok(())
    end put
end Workspace

// A rotation as the three angles a panel shows, about x, y and z, in degrees.
private euler_degrees(q: Quaternion[real]) -> [3]real
    val (yaw, pitch, roll) = q.to_euler()

    [roll / RADIANS_PER_DEGREE, pitch / RADIANS_PER_DEGREE, yaw / RADIANS_PER_DEGREE]

// A number the way a field shows it: at most two places, with no zeros trailing and no negative zero.
format_number(v: real) -> string
    val rounded = (v * 100.0).round() / 100.0
    val written = f"${rounded + 0.0}%.2f"
    var end_at = written.len

    while written[end_at - 1] == u8('0') do end_at -= 1

    if written[end_at - 1] == u8('.') then end_at -= 1

    val shown = written[0..<end_at]

    if shown == "-0" then "0" else shown
end format_number

// One of the selection's numbers, in a text field.
//
// **Typing changes nothing until it is finished with**: enter, or the field's `on_blur`, sends it to
// the document. A value the document refuses, or text that is no number, keeps the old value, marks the field
// and says why. Escape puts the old text back. A field nobody is typing in follows the document.
struct NumberField
    owner: &Workspace
    quantity: Quantity
    axis: int
    id: int
    text: &Signal[string]
    field: &View
    wrong: bool
    forgetting: bool
    typed: bool

    view(&self) -> &View = self

    private attach(&self, v: &View) = self.field = v

    // What is being typed was about a document that has gone, so the next paint throws it away unsent.
    forget(&self) = self.forgetting = true

    // The keyboard has left the field: send what was typed, as Enter would, and put the document's own text
    // back where it was refused.
    blur(&self)
        self.accept(self.shown())
        self.typed = false
        self.wrong = false
        self.text.set(self.shown())

    private shown(&self) -> string = self.owner.number(self.quantity, self.axis) match
        Some(v) -> format_number(v)
        None -> ""

    // The text says what is already there, so there is nothing to send. Otherwise, send it.
    private accept(&self, shown: string)
        val typed = self.text.read()

        if typed == shown
            self.wrong = false
            return

        val answer = parse_real(typed) match
            Ok(v) -> self.owner.put(self.quantity, self.axis, v)
            Err(_) -> if typed == "" then Err("A number is needed here") else Err(s"\"${typed}\" is not a number")

        answer match
            Ok(_) ->
                self.wrong = false
                self.owner.problem.set("")
            Err(why) ->
                self.wrong = true
                self.owner.problem.set(why)
    end accept
end NumberField

impl View for NumberField
    measure(&self, c: *Canvas, avail: Size) -> Size = self.field.measure(c, avail)

    paint(&self, c: *Canvas, r: Rect)
        val shown = self.shown()

        if self.forgetting
            self.forgetting = false
            self.wrong = false
            self.typed = false
            self.text.set(shown)

            if c.focus() == self.id then c.take_focus(NOBODY)

        val mine = c.focus() == self.id

        if mine
            if self.text.read() != shown then self.typed = true

            for p in c.keys()
                if p.key == Key.Enter
                    self.accept(shown)

                    if !self.wrong then self.typed = false
                    if !self.wrong then self.text.set(format_number(self.owner.number(self.quantity, self.axis).unwrap_or(0.0)))

                if p.key == Key.Escape
                    self.wrong = false
                    self.typed = false
                    self.owner.problem.set("")
                    self.text.set(shown)
                    c.take_focus(NOBODY)
        else
            val now = self.owner.number(self.quantity, self.axis) match
                Some(v) -> format_number(v)
                None -> ""

            if !self.typed && self.text.read() != now then self.text.set(now)

            if !self.typed then self.wrong = false

        self.field.paint(c, r)

        if self.wrong then c.stroke(r, WRONG_INK, 2, c.theme().radius)
    end paint
end NumberField

// The words of a mark: a size is its number, a gap names its axis.
mark_text(m: Mark) -> string =
    if m.gap then s"${["X", "Y", "Z"][m.axis]} gap ${format_number(m.value)}" else format_number(m.value)

// A mark's label, in points: its type, the room around its words, and its colours.
const MARK_FONT: real = 11.0
const MARK_PAD: int = 3
const MARK_BACK: u32 = 0xFFFFFFu32
const MARK_EDGE: u32 = 0xC9D1DCu32
const MARK_INK: u32 = 0x1F2937u32

// The viewport with the selection's marks written over it, each on a light label of its own. They are painted
// after the viewport, so they land on its picture rather than in the hole cut for it.
struct Dimensioned
    owner: &Workspace
    inner: &Viewport

impl View for Dimensioned
    measure(&self, c: *Canvas, avail: Size) -> Size = self.inner.measure(c, avail)

    paint(&self, c: *Canvas, r: Rect)
        self.inner.paint(c, r)

        if !self.owner.show_dimensions then return

        c.clip(r)
        c.push_font_size(MARK_FONT)
        c.ink(MARK_INK)

        for m in self.owner.measured.marks.view()
            val words = mark_text(m)
            val size = c.text_size(words)
            val x = r.x + int(m.x) - size.w / 2
            val y = r.y + int(m.y) - size.h / 2
            val label = Rect(x - MARK_PAD, y - MARK_PAD / 2, size.w + 2 * MARK_PAD, size.h + MARK_PAD)

            c.fill(label, MARK_BACK, MARK_PAD)
            c.stroke(label, MARK_EDGE, 1, MARK_PAD)
            c.text(Rect(x, y, size.w, size.h), words)

        c.unink()
        c.pop_font_size()
        c.unclip()
    end paint
end Dimensioned

private new_number_field(owner: &Workspace, q: Quantity, axis: int, id: int) -> &NumberField
    val shown = signal("")
    val field: &NumberField = NumberField(owner, q, axis, id, shown, text(""), false, false, false)

    field.attach(text_field(shown, id, NUMBER_WIDTH, on_blur = () -> field.blur()).font_size(11.0))
    field

private name_of(file: string) -> string = file_name(file).unwrap_or(file)

// A name short enough for the panel, keeping its end, which is what tells one file from the next.
private shortened(name: string) -> string =
    if name.len <= NAME_ROOM then name else "..." + name[name.len - (NAME_ROOM - 3)..<name.len]

// Text broken into lines between its words, each within this room where a word lets it be.
private wrapped(s: string, room: usize) -> string
    var out = ""
    var line = 0usize

    for word in split(s, " ")
        if line > 0 && line + 1 + word.len > room
            out += "\n"
            line = 0
        elif line > 0
            out += " "
            line += 1

        out += word
        line += word.len

    out
end wrapped

private document_filters() -> Buf[FileFilter]
    var all: Buf[FileFilter] = buf()

    all.push(FileFilter("Tekton", "tekton"))
    all
end document_filters

private stl_filters() -> Buf[FileFilter]
    var all: Buf[FileFilter] = buf()

    all.push(FileFilter("STL", "stl"))
    all
end stl_filters

private three_mf_filters() -> Buf[FileFilter]
    var all: Buf[FileFilter] = buf()

    all.push(FileFilter("3MF", "3mf"))
    all
end three_mf_filters

// What the window is called: the file's name, or Untitled before it has one, marked while anything is unsaved.
window_title(file: string, dirty: bool) -> string
    val name = if file == "" then "Untitled" else name_of(file)

    if dirty then s"• ${name} — Tekton" else s"${name} — Tekton"
end window_title

// The question about unsaved changes: its title, and its buttons, Return choosing Save and Escape Cancel.
question_title(file: string) -> string =
    if file == "" then "Save the changes to this document?" else s"Save the changes to ${name_of(file)}?"

question_buttons() -> Buf[MessageButton]
    var all: Buf[MessageButton] = buf()

    all.push(message_button(SAVE_ANSWER, "Save", on_return = true))
    all.push(message_button(DISCARD_ANSWER, "Don't Save"))
    all.push(message_button(CANCEL_ANSWER, "Cancel", on_escape = true))
    all
end question_buttons

// What the question's answer means. A box closed without a choice is Cancel, and so is one that could not be
// shown, which says why: nothing is lost that was not given up.
unsaved_answer(r: Result[Option[i32], string]) -> Unsaved =
    r match
        Ok(Some(id)) -> if id == SAVE_ANSWER then Unsaved.SaveFirst elif id == DISCARD_ANSWER then Unsaved.Discard else Unsaved.Stay("")
        Ok(None) -> Unsaved.Stay("")
        Err(why) -> Unsaved.Stay(s"Could not ask about the unsaved changes: ${why}")

new_workspace() -> &Workspace =
    Workspace(new_document(), new_camera(), new_renderer(), None, signal(0), 0, 0, false, Gesture.Idle, DEFAULT_GRID,
              layout(new_document(), new_camera(), 0.0, 0.0), buf(), signal(""), buf(), false, signal(NO_MENU), false,
              () -> stop(), "",
              (title, parent) -> ask(title, QUESTION_DETAIL, question_buttons().view(), MessageKind.Warning, parent),
              signal(false),
              (answer, parent) -> ask_open_file(answer, parent, document_filters().view(), title = "Open"),
              (answer, parent) -> ask_save_file(answer, parent, document_filters().view(), title = "Save As"),
              (answer, parent) -> ask_save_file(answer, parent, stl_filters().view(), title = "Export STL"),
              (answer, parent) -> ask_save_file(answer, parent, three_mf_filters().view(), title = "Export 3MF"), false,
              () -> window(), title -> set_title(title), "", false, CORE_ONE, true, signal(false), signal(0), signal("3"),
              signal("25"), signal("90"), true, Measures(buf(), buf()), signal(false), signal("2"), signal(0))
