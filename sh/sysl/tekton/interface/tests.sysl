// The viewport starts below the bar and right of the palette, so a click has to be measured from there.
@test
a_click_below_the_bar_picks_the_shape_drawn_there()
    val (w, a, b) = two_apart()
    var c = recorder()
    val r = viewport_rect(w, &c)

    assert(r.y > 0, "the bar takes the top of the window")
    assert(r.x > 0, "the palette takes its left")
    assert_eq(r.y + r.h, WINDOW.h, "and the viewport reaches the bottom")

    val (x, y) = w.camera.project(w.doc.bounds_of(w.doc.find(a).unwrap()).center(), real(r.w), real(r.h)).unwrap()
    val at_x = r.x + int(x)
    val at_y = r.y + int(y)

    assert(w.doc.selected == Some(b), "the last placed")
    c.point(at_x, at_y, true)
    render(w.tree(), &c, WINDOW)
    c.release(at_x, at_y)
    render(w.tree(), &c, WINDOW)
    render(w.tree(), &c, WINDOW)
    assert(w.doc.selected == Some(a), "the one under the pointer")
end a_click_below_the_bar_picks_the_shape_drawn_there

@test
the_palette_still_works_below_the_bar()
