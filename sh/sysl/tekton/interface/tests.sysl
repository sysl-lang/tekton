@test
a_dimmed_row_does_nothing_and_leaves_the_menu_open()
    val w = new_workspace()
    var c = recorder()

    choose(w, &c, "Edit", "Undo")
    assert_eq(w.problem.read(), "", "no complaint")
    assert(w.open_menu.read() != NO_MENU, "still open")
end a_dimmed_row_does_nothing_and_leaves_the_menu_open

@test
a_click_beside_an_open_menu_closes_it_and_selects_nothing()
    val (w, a, b) = two_apart()
    var c = recorder()
    val r = viewport_rect(w, &c)
    val (x, y) = w.camera.project(w.doc.bounds_of(w.doc.find(a).unwrap()).center(), real(r.w), real(r.h)).unwrap()

    assert(w.doc.selected == Some(b), "the last placed")
    assert(w.show_menu("Edit"), "open")

    val at_x = r.x + int(x)
    val at_y = r.y + int(y)

    render(w.tree(), &c, WINDOW)
    c.point(at_x, at_y, true)
    render(w.tree(), &c, WINDOW)
    c.release(at_x, at_y)
    render(w.tree(), &c, WINDOW)
    render(w.tree(), &c, WINDOW)

    assert_eq(w.open_menu.read(), NO_MENU, "closed")
    assert(w.doc.selected == Some(b), "and the shape under the click was not picked")
end a_click_beside_an_open_menu_closes_it_and_selects_nothing

@test
a_drag_and_the_wheel_over_the_viewport_do_nothing_while_a_menu_is_open()
    val (w, _, _) = two_apart()
    var c = recorder()
    val r = viewport_rect(w, &c)
    val turn = w.camera.turn
    val far = w.camera.distance
    val x = r.x + r.w - 50
    val y = r.y + r.h - 50

    assert(w.show_menu("Edit"), "open")
    render(w.tree(), &c, WINDOW)

    c.point(x, y, false)
    c.spin(0.0, 50.0)
    render(w.tree(), &c, WINDOW)
    assert(w.camera.distance == far, "the wheel does not zoom")

    c.point(x, y, true)
    render(w.tree(), &c, WINDOW)
    c.point(x - 40, y - 40, true)
    render(w.tree(), &c, WINDOW)
    assert(w.camera.turn == turn, "the drag does not turn")

    // Escape closes the menu with the button still down, and the press is still the menu's.
    c.key(press(Key.Escape))
    render(w.tree(), &c, WINDOW)
    c.point(x - 80, y - 80, true)
    render(w.tree(), &c, WINDOW)
    assert_eq(w.open_menu.read(), NO_MENU, "closed by Escape")
    assert(w.camera.turn == turn, "and the rest of that drag does not turn either")

    c.release(x - 80, y - 80)
    render(w.tree(), &c, WINDOW)
    c.spin(0.0, 50.0)
    c.point(x, y, false)
    render(w.tree(), &c, WINDOW)
    assert(w.camera.distance < far, "with the menu gone the wheel works")
end a_drag_and_the_wheel_over_the_viewport_do_nothing_while_a_menu_is_open

@test
the_delete_key_leaves_the_model_alone_while_a_menu_is_open()
    val (w, _, _) = two_apart()
