    assert(w.show_menu("Edit"), "open")
    render(w.tree(), &c, WINDOW)
    c.key(press(Key.Delete))
    render(w.tree(), &c, WINDOW)
    assert_eq(w.doc.items().len, 2, "both still there")
end the_delete_key_leaves_the_model_alone_while_a_menu_is_open

@test
a_click_on_a_title_opens_it_and_a_second_closes_it_and_neither_picks()
