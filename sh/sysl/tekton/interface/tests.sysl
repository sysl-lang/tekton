@test
a_shape_placed_out_of_view_brings_the_view_to_it()
    val w = new_workspace()

    w.camera.distance = 40.0

    for i in 0..<4 do w.add(Primitive.Box)

    val items = w.doc.items()
    val last = w.doc.bounds_of(items[items.len - 1]).center()
    val (x, _) = w.camera.project(last, 900.0, 600.0).unwrap()

    assert(x > 0.0 && x < 900.0, "the newest is in the viewport")

// ## Several selected, groups, and undo: through the pointer, the keys and the panel

private const CMD: u16 = KMOD_GUI
private const CMD_SHIFT: u16 = KMOD_GUI | KMOD_SHIFT
private const KEY_Z: u32 = 122
private const KEY_G: u32 = 103

private val WINDOW: Rect = Rect(0, 0, 1280, 800)

private shift_click(w: &Workspace, c: *Recorder, x: int, y: int)
    c.chord.keys = Modifiers(true, false, false, false)
    click_at(w, c, x, y)
    c.chord.keys = no_modifiers()
end shift_click

// Tap a named control of the whole window, where a person would.
private tap(w: &Workspace, c: *Recorder, name: string)
    val v = w.tree()

    c.taps.reset()
    render(v, c, WINDOW)

    val (x, y) = snapshot(v, c, WINDOW).click_point(name).unwrap()

    c.point(x, y, true)
    render(w.tree(), c, WINDOW)
    c.release(x, y)
    render(w.tree(), c, WINDOW)
end tap

// Whether the window shows a control of this name now.
private shows(w: &Workspace, c: *Recorder, name: string) -> bool
    val v = w.tree()

    render(v, c, WINDOW)
    snapshot(v, c, WINDOW).find(name).is_ok()
end shows

private two_apart() -> (&Workspace, int, int)
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    val b = w.doc.add_shape(Primitive.Box)

    w.doc.set_transform(b, Transform(Vec3(60.0, 0.0, 0.0), Quaternion.identity(), Vec3(1.0, 1.0, 1.0)))
    (w, a, b)
end two_apart

@test
shift_click_adds_to_the_selection_and_takes_away_from_it()
    val (w, a, b) = two_apart()
    var c = recorder()
    val (ax, ay) = centre_of(w, a)
    val (bx, by) = centre_of(w, b)

    click_at(w, &c, ax, ay)
    assert(w.doc.selected == Some(a), "one")

    shift_click(w, &c, bx, by)
    assert(w.doc.is_selected(a) && w.doc.is_selected(b), "both")
    assert(w.doc.selected.is_none(), "so no one of them is the selection")

    shift_click(w, &c, ax, ay)
    assert(w.doc.selected == Some(b), "and shift-clicking the first takes it away")

    shift_click(w, &c, 3, 3)
    assert(w.doc.selected == Some(b), "a shift-click on nothing loses nothing")

    click_at(w, &c, ax, ay)
    assert(w.doc.selected == Some(a), "a plain click is back to one")
end shift_click_adds_to_the_selection_and_takes_away_from_it

@test
several_selected_show_no_handles_and_no_numbers()
    val (w, a, b) = two_apart()
    var c = recorder()

    w.doc.select(Some(a))
    assert(layout(w.doc, w.camera, 900.0, 600.0).strokes.len() > 0, "one has handles")

    w.doc.toggle_selected(b)
    assert_eq(layout(w.doc, w.camera, 900.0, 600.0).strokes.len(), 0usize, "several do not")
    paint_field(field_of(w, POSITION, 0), &c)
    assert_eq(field_of(w, POSITION, 0).text.read(), "", "nor numbers")
end several_selected_show_no_handles_and_no_numbers

@test
a_drag_on_one_of_several_moves_them_all_by_as_much_in_one_step()
    val (w, a, b) = two_apart()
    var c = recorder()
    val (ax, ay) = centre_of(w, a)

    w.doc.select(Some(a))
    w.doc.toggle_selected(b)

    val a_at = transform_of(w, a).translation
    val b_at = transform_of(w, b).translation
    val steps = w.doc.undos.len()
    val before = w.doc.describe()

    drag_from(w, &c, ax, ay, ax + 80, ay + 10)

    val by = transform_of(w, a).translation - a_at

    assert(by.length() > 1.0, "the one under the pointer moved")
    assert((transform_of(w, b).translation - b_at - by).length() < 1.0e-9, "the other by as much")
    assert(w.doc.is_selected(a) && w.doc.is_selected(b), "both still selected")
    assert_eq(w.doc.undos.len(), steps + 1, "one step")
    w.undo()
    assert_eq(w.doc.describe(), before, "and one undo takes both back")
end a_drag_on_one_of_several_moves_them_all_by_as_much_in_one_step

@test
a_drag_of_many_frames_is_one_step_and_a_handle_drag_too()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    var c = recorder()
    val (x, y) = centre_of(w, a)
    val before = w.doc.describe()
    val steps = w.doc.undos.len()

    paint_frame(w, &c)
    c.point(x, y, true)
    paint_frame(w, &c)

    for i in 1..30
        c.point(x + i * 5, y, true)
        paint_frame(w, &c)

    c.release(x + 150, y)
    paint_frame(w, &c)
    assert_eq(w.doc.undos.len(), steps + 1, "thirty frames, one step")
    w.undo()
    assert_eq(w.doc.describe(), before, "and undone in one")

    val (hx, hy) = spot_of(w, Grip.Raise)
    val raised = w.doc.undos.len()

    drag_from(w, &c, hx, hy, hx, hy - 60)
    assert_eq(w.doc.undos.len(), raised + 1, "a handle, one step")
end a_drag_of_many_frames_is_one_step_and_a_handle_drag_too

@test
a_drag_that_goes_nowhere_or_a_click_is_no_step()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    var c = recorder()
    val (x, y) = centre_of(w, a)
    val steps = w.doc.undos.len()

    click_at(w, &c, x, y)
    assert_eq(w.doc.undos.len(), steps, "a click")

    paint_frame(w, &c)
    c.point(x, y, true)
    paint_frame(w, &c)
    c.point(x + 40, y, true)
    paint_frame(w, &c)
    c.point(x, y, true)
    paint_frame(w, &c)
    c.release(x, y)
    paint_frame(w, &c)
    assert_eq(w.doc.undos.len(), steps, "and out and back")
end a_drag_that_goes_nowhere_or_a_click_is_no_step

@test
a_typed_value_is_one_step()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    var c = recorder()
    val steps = w.doc.undos.len()

    type_into(field_of(w, POSITION, 0), &c, "35", Key.Enter)
    assert(transform_of(w, a).translation.x == 35.0, "it took")
    assert_eq(w.doc.undos.len(), steps + 1, "one step")
    type_into(field_of(w, POSITION, 0), &c, "not a number", Key.Enter)
    assert_eq(w.doc.undos.len(), steps + 1, "and one that was refused is none")
end a_typed_value_is_one_step

@test
the_shortcuts_group_ungroup_undo_and_redo()
    val (w, a, b) = two_apart()

    w.doc.select(Some(a))
    w.doc.toggle_selected(b)

    val before = w.doc.describe()

    assert(w.shortcut(KEY_G, CMD, false), "taken")
    assert_eq(w.doc.items().len, 1, "grouped")

    val grouped = w.doc.describe()

    assert(w.shortcut(KEY_G, CMD_SHIFT, false), "taken")
    assert_eq(w.doc.items().len, 2, "ungrouped")

    assert(w.shortcut(KEY_Z, CMD, false), "taken")
    assert_eq(w.doc.describe(), grouped, "undone")
    assert(w.shortcut(KEY_Z, CMD, true), "held down, it goes on")
    assert_eq(w.doc.describe(), before, "undone again")
    assert(w.shortcut(KEY_Z, CMD_SHIFT, false), "taken")
    assert_eq(w.doc.describe(), grouped, "redone")

    assert(!w.shortcut(KEY_Z, 0u16, false), "without the command key it is a letter")
    assert(!w.shortcut(KEY_Z, KMOD_SHIFT, false), "and with only shift")
    assert(!w.shortcut(u32(97), CMD, false), "and another letter is not ours")
    assert_eq(w.doc.describe(), grouped, "and those changed nothing")

    w.shortcut(KEY_G, CMD_SHIFT, true)
    assert_eq(w.doc.describe(), grouped, "a held key does not go on ungrouping")
end the_shortcuts_group_ungroup_undo_and_redo

@test
a_shortcut_waits_while_a_field_is_being_typed_in_or_a_shape_dragged()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    var c = recorder()
    val (x, y) = centre_of(w, a)

    c.take_focus(FIRST_FIELD_ID)
    paint_frame(w, &c)
    assert(!w.shortcut(KEY_Z, CMD, false), "the field keeps it")
    assert_eq(w.doc.items().len, 1, "still there")
    c.take_focus(NOBODY)
    paint_frame(w, &c)

    paint_frame(w, &c)
    c.point(x, y, true)
    paint_frame(w, &c)
    c.point(x + 40, y, true)
    paint_frame(w, &c)

    val during = transform_of(w, a)

    w.undo()
    w.delete()
    assert_eq(w.doc.items().len, 1, "not in the middle of a drag")
    assert(transform_of(w, a) == during, "which goes on")
    c.release(x + 40, y)
    paint_frame(w, &c)
end a_shortcut_waits_while_a_field_is_being_typed_in_or_a_shape_dragged

@test
the_delete_key_deletes_the_selection_and_not_while_typing()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    val b = w.doc.add_shape(Primitive.Box)
    var c = recorder()

    w.doc.select(Some(a))
    c.key(press(Key.Delete))
    paint_frame(w, &c)
    assert_eq(w.doc.items().len, 1, "gone")
    assert(w.doc.selection.len() == 0, "and nothing is selected")

    w.undo()
    assert_eq(w.doc.items().len, 2, "back")
    assert(w.doc.selected == Some(a), "and selected")

    c.key(press(Key.Backspace))
    paint_frame(w, &c)
    assert_eq(w.doc.items().len, 1, "the key a Mac calls delete")
    w.undo()

    c.take_focus(FIRST_FIELD_ID)
    c.key(press(Key.Backspace))
    paint_frame(w, &c)
    assert_eq(w.doc.items().len, 2, "a field's backspace is the field's")
    c.take_focus(NOBODY)

    val steps = w.doc.undos.len()

    w.doc.select(None)
    c.key(press(Key.Delete))
    paint_frame(w, &c)
    assert_eq(w.doc.undos.len(), steps, "with nothing selected it is nothing")
    assert_eq(w.problem.read(), "", "and no complaint")
    assert(b != a, "two shapes all along")
end the_delete_key_deletes_the_selection_and_not_while_typing

@test
the_panel_offers_what_the_selection_can_do_and_each_button_does_it()
    val (w, a, b) = two_apart()
    var c = recorder()

    w.doc.select(None)
    assert(!shows(w, &c, "panel.solid"), "nothing selected: no solid or hole")
    assert(!shows(w, &c, "panel.delete"), "nor delete")

    w.doc.select(Some(a))
    assert(shows(w, &c, "panel.hole"), "one: solid or hole")
    assert(!shows(w, &c, "panel.group"), "not group")
    assert(!shows(w, &c, "panel.ungroup"), "nor ungroup")

    tap(w, &c, "panel.hole")
    assert(w.doc.find(a).unwrap().hole, "the hole button")
    tap(w, &c, "panel.solid")
    assert(!w.doc.find(a).unwrap().hole, "the solid button")

    tap(w, &c, "undo")
    assert(w.doc.find(a).unwrap().hole, "the undo button")
    tap(w, &c, "redo")
    assert(!w.doc.find(a).unwrap().hole, "the redo button")

    w.doc.toggle_selected(b)
    assert(shows(w, &c, "panel.group"), "two: group")

    tap(w, &c, "panel.group")
    assert_eq(w.doc.items().len, 1, "the group button")
    assert(shows(w, &c, "panel.ungroup"), "a group: ungroup")

    tap(w, &c, "panel.ungroup")
    assert_eq(w.doc.items().len, 2, "the ungroup button")

    tap(w, &c, "panel.delete")
    assert_eq(w.doc.items().len, 0, "the delete button")
end the_panel_offers_what_the_selection_can_do_and_each_button_does_it

@test
a_refused_group_says_why_in_the_panel_and_the_next_command_clears_it()
    val (w, a, b) = two_apart()
    var c = recorder()

    w.doc.select(Some(a))
    w.doc.toggle_selected(b)
    tap(w, &c, "panel.hole")
    tap(w, &c, "panel.group")
    assert(w.problem.read().contains("solid"), "says what is missing")
    assert_eq(w.doc.items().len, 2, "and they stand as they were")

    tap(w, &c, "panel.solid")
    assert_eq(w.problem.read(), "", "cleared")
end a_refused_group_says_why_in_the_panel_and_the_next_command_clears_it

@test
a_panel_message_with_nothing_selected_is_still_shown()
    val w = new_workspace()
    var c = recorder()

    w.group()
    assert(w.problem.read() != "", "says why")
    render(w.tree(), &c, WINDOW)
end a_panel_message_with_nothing_selected_is_still_shown

// Whether a row of this menu is live, reading the window with the menu open and leaving it closed.
private live(w: &Workspace, c: *Recorder, title: string, label: string) -> bool
    assert(w.show_menu(title), "a menu of that title")

    val v = w.tree()

    render(v, c, WINDOW)

    val row = snapshot(v, c, WINDOW).find(s"menu.${title}.${label}").unwrap()

    w.open_menu.set(NO_MENU)
    row.marks.index_of("disabled").is_none()
end live

private edit_live(w: &Workspace, c: *Recorder, label: string) -> bool = live(w, c, "Edit", label)

// Open a menu by its title and choose a row, where a person would.
private choose(w: &Workspace, c: *Recorder, title: string, label: string)
    tap(w, c, s"menu.${title}")
    tap(w, c, s"menu.${title}.${label}")
end choose

// The rectangle the window gives the viewport, which is everything the bar and the palette leave.
private viewport_rect(w: &Workspace, c: *Recorder) -> Rect
    render(w.tree(), c, WINDOW)

    Rect(WINDOW.w - w.width, WINDOW.h - w.height, w.width, w.height)
end viewport_rect

@test
an_empty_document_has_only_the_file_menu_to_offer()
    val w = new_workspace()
    var c = recorder()

    for label in ["New", "Open", "Save", "Save As", "Quit"]
        assert(live(w, &c, "File", label), label)

    for label in ["Undo", "Redo", "Delete", "Group", "Ungroup", "Solid", "Hole"]
        assert(!edit_live(w, &c, label), label)

    assert(!live(w, &c, "View", "Frame All"), "nothing to frame")
end an_empty_document_has_only_the_file_menu_to_offer

@test
each_row_follows_the_selection()
    val (w, a, b) = two_apart()
    var c = recorder()

    assert(edit_live(w, &c, "Undo"), "two shapes were added")
    assert(!edit_live(w, &c, "Redo"), "and nothing has been undone")
    assert(live(w, &c, "View", "Frame All"), "something to frame")

    w.doc.select(None)
    assert(!edit_live(w, &c, "Delete"), "nothing selected")
    assert(!edit_live(w, &c, "Hole"), "nothing selected to be a hole")
    assert(!edit_live(w, &c, "Solid"), "nothing selected to be solid")

    w.doc.select(Some(a))
    assert(edit_live(w, &c, "Delete"), "one selected can go")
    assert(!edit_live(w, &c, "Group"), "one is too few to group")
    assert(!edit_live(w, &c, "Ungroup"), "a shape is not a group")
    assert(edit_live(w, &c, "Hole"), "a solid can become a hole")
    assert(!edit_live(w, &c, "Solid"), "and is already solid")

    w.doc.toggle_selected(b)
    assert(edit_live(w, &c, "Group"), "two can group")

    w.group()
    assert(edit_live(w, &c, "Ungroup"), "and a group can come apart")
    assert(!edit_live(w, &c, "Group"), "and one group is too few")

    w.undo()
    assert(edit_live(w, &c, "Redo"), "something has been undone")
end each_row_follows_the_selection

@test
a_mixed_selection_can_become_either_and_all_holes_cannot_group()
    val (w, a, b) = two_apart()
    var c = recorder()

    w.doc.select(Some(a))
    w.set_hole(true)
    w.doc.toggle_selected(b)
    assert(edit_live(w, &c, "Solid"), "one is a hole")
    assert(edit_live(w, &c, "Hole"), "one is solid")
    assert(edit_live(w, &c, "Group"), "a solid and a hole can group")

    w.set_hole(true)
    assert(edit_live(w, &c, "Solid"), "all holes can become solid")
    assert(!edit_live(w, &c, "Hole"), "and are already holes")
    assert(!edit_live(w, &c, "Group"), "a group needs a solid part")
end a_mixed_selection_can_become_either_and_all_holes_cannot_group

// Each state asks the row and then the command itself, so a row can't be live over a command that refuses.
@test
a_row_is_live_exactly_where_its_command_is_not_refused()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    val b = w.doc.add_shape(Primitive.Box)
    val hole = w.doc.add_shape(Primitive.Sphere)
    val parts = w.doc.add_shape(Primitive.Box)
    val other = w.doc.add_shape(Primitive.Box)

    w.doc.set_transform(b, Transform(Vec3(60.0, 0.0, 0.0), Quaternion.identity(), Vec3(1.0, 1.0, 1.0)))
    w.doc.select(Some(hole))
    w.doc.set_hole(true).expect("a hole")
    w.doc.select(Some(parts))
    w.doc.toggle_selected(other)

    val group = w.doc.group_selected().expect("a group")

    rows_agree_with_commands(w, [a])
    rows_agree_with_commands(w, [hole])
    rows_agree_with_commands(w, [group])
    rows_agree_with_commands(w, [a, b])
    rows_agree_with_commands(w, [a, hole])
    rows_agree_with_commands(w, [a, group])
    w.doc.select(None)
    assert(!w.doc.can_group() && !w.doc.can_ungroup() && !w.doc.can_delete, "nothing selected, nothing applies")
end a_row_is_live_exactly_where_its_command_is_not_refused

private rows_agree_with_commands(w: &Workspace, ids: []int)
    w.doc.select(None)

    for id in ids do w.doc.toggle_selected(id)

    val can_group = w.doc.can_group()
    val can_ungroup = w.doc.can_ungroup()
    val can_delete = w.doc.can_delete

    assert_eq(w.doc.group_selected().is_ok(), can_group, "group")

    if can_group then w.doc.undo()

    assert_eq(w.doc.ungroup_selected().is_ok(), can_ungroup, "ungroup")

    if can_ungroup then w.doc.undo()

    assert_eq(w.doc.delete_selected().is_ok(), can_delete, "delete")

    if can_delete then w.doc.undo()
end rows_agree_with_commands

@test
undo_and_redo_run_through_their_rows()
    val (w, a, _) = two_apart()
    var c = recorder()

    w.doc.select(Some(a))

    val before = w.doc.describe()

    choose(w, &c, "Edit", "Delete")
    assert_eq(w.doc.items().len, 1, "deleted")
    assert_eq(w.open_menu.read(), NO_MENU, "and choosing closed the menu")

    choose(w, &c, "Edit", "Undo")
    assert_eq(w.doc.items().len, 2, "back through the row")
    assert(w.doc.selected == Some(a), "selection and all")

    choose(w, &c, "Edit", "Redo")
    assert_eq(w.doc.items().len, 1, "and gone again")

    choose(w, &c, "Edit", "Undo")
    assert_eq(w.doc.describe(), before, "exactly as it was")
end undo_and_redo_run_through_their_rows

@test
group_ungroup_solid_and_hole_run_through_their_rows()
    val (w, a, b) = two_apart()
    var c = recorder()

    w.doc.select(Some(a))
    w.doc.toggle_selected(b)
    choose(w, &c, "Edit", "Group")
    assert_eq(w.doc.items().len, 1, "grouped")

    choose(w, &c, "Edit", "Ungroup")
    assert_eq(w.doc.items().len, 2, "apart")

    w.doc.select(Some(a))
    choose(w, &c, "Edit", "Hole")
    assert(w.doc.find(a).unwrap().hole, "a hole")

    choose(w, &c, "Edit", "Solid")
    assert(!w.doc.find(a).unwrap().hole, "solid again")
end group_ungroup_solid_and_hole_run_through_their_rows

@test
frame_all_brings_the_document_into_view()
    val (w, _, b) = two_apart()
    var c = recorder()

    w.camera.target = Vec3(5000.0, 5000.0, 5000.0)
    choose(w, &c, "View", "Frame All")
    assert(w.camera.target.x < 100.0, "the view came back")
    assert(w.doc.selected == Some(b), "and the selection is as it was")
end frame_all_brings_the_document_into_view

// The build volume shows from the start, on the CORE One, and the View menu's row hides and shows it again
// whatever is in the document, leaving the document alone.
@test
build_volume_toggles_from_the_view_menu()
    val w = new_workspace()
    var c = recorder()
    val changes = w.changes.read()

    assert(w.show_volume, "shown from the start")
    assert(w.printer == CORE_ONE, "for the CORE One")
    assert(live(w, &c, "View", "Build Volume"), "live with nothing in the document")

    choose(w, &c, "View", "Build Volume")
    assert(!w.show_volume, "hidden")
    assert(w.changes.read() > changes, "and the window is told to draw again")
    assert_eq(w.open_menu.read(), NO_MENU, "choosing closed the menu")

    choose(w, &c, "View", "Build Volume")
    assert(w.show_volume, "shown again")
    assert(!w.doc.is_dirty() && !w.doc.can_undo, "the document is not edited by a view setting")
end build_volume_toggles_from_the_view_menu

// A mark's words: a size is its number with at most two places, a gap names its axis.
@test
marks_read_as_trimmed_millimetres()
    assert_eq(mark_text(Mark(0, false, 20.0, 0.0, 0.0)), "20", "whole")
    assert_eq(mark_text(Mark(1, false, 20.4, 0.0, 0.0)), "20.4", "one place")
    assert_eq(mark_text(Mark(2, false, 0.25, 0.0, 0.0)), "0.25", "two places")
    assert_eq(mark_text(Mark(2, false, 1.006, 0.0, 0.0)), "1.01", "rounded to two")
    assert_eq(mark_text(Mark(0, true, 5.0, 0.0, 0.0)), "X gap 5", "a gap along x")
    assert_eq(mark_text(Mark(1, true, 2.5, 0.0, 0.0)), "Y gap 2.5", "along y")
    assert_eq(mark_text(Mark(2, true, 0.0, 0.0, 0.0)), "Z gap 0", "touching along z")
end marks_read_as_trimmed_millimetres

// Dimensions show from the start: a pair's sizes and gap are written over the viewport, and its gap line joins
// the strokes. The View menu's row hides all of it and shows it again, leaving the document alone.
@test
dimensions_toggle_from_the_view_menu()
    val w = new_workspace()
    var c = recorder()
    val a = w.doc.add_shape(Primitive.Box)
    val b = w.doc.add_shape(Primitive.Box)

    w.doc.move_to(b, w.doc.find(a).unwrap().transform.translation + Vec3(30.0, 0.0, 0.0)).unwrap()
    w.doc.toggle_selected(a)

    val before = w.doc.describe()

    assert(w.show_dimensions, "shown from the start")
    render(w.dimensioned(), &c, AT)
    assert_eq(w.measured.marks.len(), 4, "three sizes and the gap along x")
    assert_eq(w.overlay.strokes.len(), 2, "the gap's line, with no handles on a pair")

    val drawn = c.ops.view()
    var words = 0

    for op in drawn do if op.contains("'X gap 10'") || op.contains("'50'") || op.contains("'20'") then words += 1

    assert_eq(words, 4, "the marks are written")

    choose(w, &c, "View", "Dimensions")
    assert(!w.show_dimensions, "hidden")

    var hidden = recorder()

    render(w.dimensioned(), &hidden, AT)
    assert_eq(w.measured.marks.len(), 0, "nothing measured")
    assert_eq(w.overlay.strokes.len(), 0, "and no line")

    for op in hidden.ops.view() do assert(!op.contains("gap"), "nothing written")

    choose(w, &c, "View", "Dimensions")
    assert(w.show_dimensions, "shown again")
    render(w.dimensioned(), &c, AT)
    assert_eq(w.measured.marks.len(), 4, "measured again")
    assert_eq(w.doc.describe(), before, "the document is not edited by a view setting")
end dimensions_toggle_from_the_view_menu

// One shape keeps its handles, and its sizes' marks add no strokes to them.
@test
a_single_shape_keeps_exactly_its_handles()
    val w = new_workspace()
    var c = recorder()

    w.doc.add_shape(Primitive.Box)
    render(w.dimensioned(), &c, AT)

    assert_eq(w.measured.marks.len(), 3, "three sizes")
    assert_eq(w.overlay.strokes.len(), layout(w.doc, w.camera, 900.0, 600.0).strokes.len(), "the handles alone")
end a_single_shape_keeps_exactly_its_handles

