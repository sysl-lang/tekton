// ## Segments

private const SEGMENTS: int = 3

@test
the_segments_field_shows_only_for_a_round_shape()
    val w = new_workspace()
    val box = w.doc.add_shape(Primitive.Box)
    var c = recorder()

    assert(!shows(w, &c, "panel.segments"), "not for a box")

    for p in [Primitive.Cylinder, Primitive.Sphere, Primitive.Cone, Primitive.Torus]
        w.doc.select(Some(w.doc.add_shape(p)))
        assert(shows(w, &c, "panel.segments"), "for a round shape")

    w.doc.toggle_selected(box)
    assert(!shows(w, &c, "panel.segments"), "not for several")

    val group = w.doc.group_selected().unwrap()

    w.doc.select(Some(group))
    assert(!shows(w, &c, "panel.segments"), "nor for a group")
    w.doc.select(None)
    assert(!shows(w, &c, "panel.segments"), "nor for nothing")

@test
typing_segments_sets_them_held_to_the_range_as_one_step()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Cylinder)
    var c = recorder()
    val f = field_of(w, SEGMENTS, 0)

    paint_field(f, &c)
    assert_eq(f.text.read(), "64", "the default")

    val steps = w.doc.undos.len()

    type_into(f, &c, "12", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().segments, Some(12), "set")
    assert_eq(w.doc.undos.len(), steps + 1, "one step")

    type_into(f, &c, "1000", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().segments, Some(512), "held to the most")
    paint_field(f, &c)
    assert_eq(f.text.read(), "512", "and the field says so")

    type_into(f, &c, "1", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().segments, Some(3), "held to the fewest")
    type_into(f, &c, "-1e300", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().segments, Some(3), "however few")
    type_into(f, &c, "1e300", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().segments, Some(512), "however many")

    for bad in ["", "abc", "12.5", "nan", "inf"]
        type_into(f, &c, bad, Key.Enter)
        assert_eq(w.doc.find(a).unwrap().segments, Some(512), s"kept, for '${bad}'")
        assert(f.wrong, s"marked, for '${bad}'")
        assert(w.problem.read() != "", s"and explained, for '${bad}'")

    assert(w.doc.undo(), "undone")
    assert_eq(w.doc.find(a).unwrap().segments, Some(3), "one edit back")

// ## Clearance

private clearance_field(w: &Workspace) -> &NumberField = w.number_fields()[10]

@test
the_clearance_field_shows_only_for_a_hole_that_takes_one()
    val w = new_workspace()
    val box = w.doc.add_shape(Primitive.Box)
    var c = recorder()

    assert(!shows(w, &c, "panel.clearance"), "not for a solid")

    for p in [Primitive.Box, Primitive.Cylinder, Primitive.Sphere, Primitive.Cone]
        w.doc.select(Some(w.doc.add_shape(p)))
        w.doc.set_hole(true).unwrap()
        assert(shows(w, &c, "panel.clearance"), s"for a ${primitive_name(p)} hole")

    w.doc.select(Some(w.doc.add_shape(Primitive.Torus)))
    w.doc.set_hole(true).unwrap()
    assert(!shows(w, &c, "panel.clearance"), "not for a torus hole")

    w.doc.toggle_selected(box)
    assert(!shows(w, &c, "panel.clearance"), "not for several")

    val group = w.doc.group_selected().unwrap()

    w.doc.select(Some(group))
    w.doc.set_hole(true).unwrap()
    assert(!shows(w, &c, "panel.clearance"), "nor for a hole group")
    w.doc.select(None)
    assert(!shows(w, &c, "panel.clearance"), "nor for nothing")

@test
typing_a_clearance_sets_it_held_to_the_range_as_one_step()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Cylinder)
    var c = recorder()
    val f = clearance_field(w)

    w.doc.set_hole(true).unwrap()
    paint_field(f, &c)
    assert_eq(f.text.read(), "0", "none to start")

    val steps = w.doc.undos.len()

    type_into(f, &c, "0.2", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().clearance, 0.2, "set")
    assert_eq(w.doc.undos.len(), steps + 1, "one step")
    paint_field(f, &c)
    assert_eq(f.text.read(), "0.2", "and shown")

    type_into(f, &c, "5", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().clearance, 2.0, "held to the most")
    paint_field(f, &c)
    assert_eq(f.text.read(), "2", "and the field says so")
    type_into(f, &c, "-1", Key.Enter)
    assert_eq(w.doc.find(a).unwrap().clearance, 0.0, "held to none")
    type_into(f, &c, "0.15", Key.Enter)

    for bad in ["", "abc", "nan", "inf", "-inf"]
        type_into(f, &c, bad, Key.Enter)
        assert_eq(w.doc.find(a).unwrap().clearance, 0.15, s"kept, for '${bad}'")
        assert(f.wrong, s"marked, for '${bad}'")
        assert(w.problem.read() != "", s"and explained, for '${bad}'")

    assert(w.doc.undo(), "undone")
    assert_eq(w.doc.find(a).unwrap().clearance, 0.0, "one edit back")

@test
switching_a_hole_with_a_clearance_to_solid_keeps_it_hidden()
    val w = new_workspace()
    val a = w.doc.add_shape(Primitive.Box)
    var c = recorder()

    w.doc.set_hole(true).unwrap()
    type_into(clearance_field(w), &c, "0.4", Key.Enter)
    w.doc.set_hole(false).unwrap()
    assert(!shows(w, &c, "panel.clearance"), "hidden on a solid")
    assert_eq(w.doc.find(a).unwrap().clearance, 0.4, "but kept")
    w.doc.set_hole(true).unwrap()
    assert(shows(w, &c, "panel.clearance"), "back with the hole")
    paint_field(clearance_field(w), &c)
    assert_eq(clearance_field(w).text.read(), "0.4", "saying what it was")
