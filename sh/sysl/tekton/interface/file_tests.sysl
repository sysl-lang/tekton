module sh.sysl.tekton.interface
@tests

import sh.sysl.sdl3.{DialogResult, HINT_VIDEO_DRIVER, INIT_VIDEO, KMOD_GUI, KMOD_SHIFT, WINDOW_HIDDEN, Window, create_window, init,
                     set_hint}
import sh.sysl.tekton.camera.new_camera
import sh.sysl.tekton.document.{Node, Primitive, identity_transform, restored_document, restored_group, restored_shape}
import sh.sysl.tekton.export.three_mf_bytes
import sh.sysl.tekton.files.document_text
import sh.sysl.ui.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_bytes, read_text, remove_dir_all, set_permissions, write_text}

// The File menu and the question about unsaved changes, in the whole window, with file dialogs that answer at
// once as a test tells them to.

private val WINDOW: Rect = Rect(0, 0, 1280, 800)

const NO_MODS: u16 = 0
const REPEAT: bool = true

private tap(w: &Workspace, c: *Recorder, name: string)
    val v = w.tree()

    c.taps.reset()
    render(v, c, WINDOW)

    val (x, y) = snapshot(v, c, WINDOW).click_point(name).unwrap()

    c.point(x, y, true)
    render(w.tree(), c, WINDOW)
    c.release(x, y)
    render(w.tree(), c, WINDOW)
end tap

private choose(w: &Workspace, c: *Recorder, label: string)
    tap(w, c, "menu.File")
    tap(w, c, s"menu.File.${label}")
end choose

private shows(w: &Workspace, c: *Recorder, name: string) -> bool
    val v = w.tree()

    render(v, c, WINDOW)
    snapshot(v, c, WINDOW).find(name).is_ok()
end shows

private key(w: &Workspace, letter: char, mods: u16 = KMOD_GUI, repeat: bool = false) -> bool =
    w.shortcut(u32(u8(letter)), mods, repeat)

// What a dialog says each time it is asked, and how many times it was; what the question about unsaved changes
// answers, how many times it was asked and with what title.
private struct Dialogs
    answer: DialogResult
    opens: int
    saves: int
    exports: int
    three_mf_exports: int
    reply: Result[Option[i32], string]
    questions: int
    asked: string

private chosen(file: string) -> DialogResult
    var paths: Buf[string] = buf()

    paths.push(file)
    DialogResult.Chosen(paths)
end chosen

// A workspace whose dialogs and question answer from what is returned with it, and whose Quit is counted by the
// third. The question says Cancel until told otherwise.
private workspace() -> (&Workspace, &Dialogs, &Signal[int])
    val w = new_workspace()
    val d: &Dialogs = Dialogs(DialogResult.Cancelled, 0, 0, 0, 0, Ok(Some(CANCEL_ANSWER)), 0, "")
    val quits = signal(0)

    w.ask_open = (answer, parent) ->
        d.opens += 1
        answer(d.answer)
    w.ask_save = (answer, parent) ->
        d.saves += 1
        answer(d.answer)
    w.ask_export_stl = (answer, parent) ->
        d.exports += 1
        answer(d.answer)
    w.ask_export_3mf = (answer, parent) ->
        d.three_mf_exports += 1
        answer(d.answer)
    w.ask_changes = (title, parent) ->
        d.questions += 1
        d.asked = title
        d.reply
    w.quit = () -> quits.set(quits.read() + 1)
    (w, d, quits)
end workspace

private val SAVE: Result[Option[i32], string] = Ok(Some(SAVE_ANSWER))
private val DISCARD: Result[Option[i32], string] = Ok(Some(DISCARD_ANSWER))

private dir() -> string = make_temp_dir("tekton-menu").unwrap()

// A file holding one box, to be opened.
private box_file(dir: string) -> string
    val doc = new_workspace().doc
    val file = s"${dir}/box.tekton"

    doc.add_shape(Primitive.Box)
    write_text(file, document_text(doc)).unwrap()
    file
end box_file

@test
the_file_menu_lists_its_commands_with_their_shortcuts()
    val (w, _, _) = workspace()
    var c = recorder()

    tap(w, &c, "menu.File")

    for label in ["New", "Open", "Save", "Save As", "Export STL…", "Export 3MF…", "Quit"]
        assert(shows(w, &c, s"menu.File.${label}"), label)
end the_file_menu_lists_its_commands_with_their_shortcuts

@test
export_3mf_writes_the_solid_and_leaves_the_document_its_file_and_mark()
    val (w, d, _) = workspace()
    var c = recorder()
    val at = dir()
    val doc_file = box_file(at)

    assert(w.open_path(doc_file), "opened")
    w.add(Primitive.Sphere)
    d.answer = chosen(s"${at}/part")
    choose(w, &c, "Export 3MF…")
    assert_eq(d.three_mf_exports, 1, "asked where")
    assert_eq(d.exports, 0, "not the STL dialog")
    assert_eq(read_bytes(s"${at}/part.3mf").unwrap(), three_mf_bytes(w.doc.final_mesh().unwrap(), "part").unwrap().view(),
              "written, with its extension, box and sphere, named after the file")
    assert_eq(w.file, doc_file, "the document's own file")
    assert(w.doc.is_dirty(), "still unsaved")
    assert_eq(w.problem.read(), "", "nothing wrong")
    assert(!w.in_dialog.read(), "the dialog is gone")
    remove_dir_all(at).unwrap()
end export_3mf_writes_the_solid_and_leaves_the_document_its_file_and_mark

@test
export_3mf_of_an_empty_document_says_why_and_asks_nothing()
    val (w, d, _) = workspace()
    var c = recorder()

    choose(w, &c, "Export 3MF…")
    assert_eq(d.three_mf_exports, 0, "no dialog")
    assert_eq(w.problem.read(), "Could not export: There is nothing solid to export", "the panel says why")
end export_3mf_of_an_empty_document_says_why_and_asks_nothing

@test
export_3mf_to_where_no_file_can_be_says_so()
    val (w, d, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    d.answer = chosen("/no/such/directory/part")
    choose(w, &c, "Export 3MF…")
    assert(w.problem.read().starts_with("Could not export part.3mf: "), s"named: ${w.problem.read()}")
end export_3mf_to_where_no_file_can_be_says_so

@test
export_stl_writes_the_solid_and_leaves_the_document_its_file_and_mark()
    val (w, d, _) = workspace()
    var c = recorder()
    val at = dir()
    val doc_file = box_file(at)

    assert(w.open_path(doc_file), "opened")
    w.add(Primitive.Sphere)
    d.answer = chosen(s"${at}/part")
    choose(w, &c, "Export STL…")
    assert_eq(d.exports, 1, "asked where")
    assert_eq(read_bytes(s"${at}/part.stl").unwrap().len, 84 + 50 * w.doc.final_mesh().unwrap().triangle_count(),
              "written, with its extension, box and sphere")
    assert_eq(w.file, doc_file, "the document's own file")
    assert(w.doc.is_dirty(), "still unsaved")
    assert_eq(w.problem.read(), "", "nothing wrong")
    assert(!w.in_dialog.read(), "the dialog is gone")
    remove_dir_all(at).unwrap()
end export_stl_writes_the_solid_and_leaves_the_document_its_file_and_mark

@test
export_stl_of_an_empty_document_says_why_and_asks_nothing()
    val (w, d, _) = workspace()
    var c = recorder()

    choose(w, &c, "Export STL…")
    assert_eq(d.exports, 0, "no dialog")
    assert_eq(w.problem.read(), "Could not export: There is nothing solid to export", "the panel says why")
end export_stl_of_an_empty_document_says_why_and_asks_nothing

@test
export_stl_of_a_refused_group_says_why_and_asks_nothing()
    val (w, d, _) = workspace()
    var c = recorder()

    // No command makes one, so the tree is made directly: a group whose only part is a hole.
    var parts: Buf[&Node] = buf()

    parts.push(restored_shape(2, Primitive.Box, identity_transform(), 0, true))

    var items: Buf[&Node] = buf()

    items.push(restored_group(1, identity_transform(), 0, false, parts))
    w.doc = restored_document(items, 3, None, 1)

    choose(w, &c, "Export STL…")
    assert_eq(d.exports, 0, "no dialog")
    assert_eq(w.problem.read(), "Could not export: A group needs a solid part (shape 1)", "the panel says why")
end export_stl_of_a_refused_group_says_why_and_asks_nothing

@test
export_stl_to_where_no_file_can_be_says_so_and_cancel_says_nothing()
    val (w, d, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    d.answer = chosen("/no/such/directory/part.stl")
    choose(w, &c, "Export STL…")
    assert(w.problem.read().starts_with("Could not export part.stl: "), s"named: ${w.problem.read()}")

    d.answer = DialogResult.Cancelled
    choose(w, &c, "Export STL…")
    assert_eq(d.exports, 2, "asked again")
    assert(w.problem.read().starts_with("Could not export part.stl: "), "a cancel leaves the panel as it was")

    val at = dir()

    d.answer = chosen(s"${at}/part.stl")
    choose(w, &c, "Export STL…")
    assert_eq(w.problem.read(), "", "an export that works clears it")
    remove_dir_all(at).unwrap()
end export_stl_to_where_no_file_can_be_says_so_and_cancel_says_nothing

@test
new_on_a_clean_document_asks_nothing()
    val (w, d, _) = workspace()
    var c = recorder()
    val was = w.doc

    choose(w, &c, "New")
    assert_eq(d.questions, 0, "no question")
    assert(w.doc !== was, "a new document")
    assert_eq(w.file, "", "with no file")
end new_on_a_clean_document_asks_nothing

@test
new_on_unsaved_changes_asks_and_cancel_keeps_everything()
    val (w, d, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)

    val was = w.doc

    choose(w, &c, "New")
    assert_eq(d.questions, 1, "a question")
    assert_eq(d.asked, "Save the changes to this document?", "about this document")
    assert(w.doc === was, "the same document")
    assert_eq(w.doc.items().len, 1, "whole")
    assert_eq(w.problem.read(), "", "and cancelling is no problem")
    assert(shows(w, &c, "palette.box"), "and the window is still there to use")
end new_on_unsaved_changes_asks_and_cancel_keeps_everything

@test
the_question_names_the_file_it_would_save_to()
    val (w, d, _) = workspace()
    val where = dir()

    w.add(Primitive.Box)
    d.answer = chosen(s"${where}/part.tekton")
    w.save()
    w.add(Primitive.Box)
    w.new_file()
    assert_eq(d.asked, "Save the changes to part.tekton?", "by its name")
    remove_dir_all(where).unwrap()
end the_question_names_the_file_it_would_save_to

@test
a_question_closed_without_an_answer_is_cancel()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    d.reply = Ok(None)
    w.request_quit()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(w.doc.items().len, 1, "with the document")
    assert_eq(w.problem.read(), "", "and closing it is no problem")
end a_question_closed_without_an_answer_is_cancel

@test
a_question_that_cannot_be_asked_stays_and_says_why()
    val (w, d, quits) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    d.reply = Err("no window server")
    choose(w, &c, "New")
    w.request_quit()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(w.doc.items().len, 1, "with the document")
    assert_eq(w.problem.read(), "Could not ask about the unsaved changes: no window server", "said")
    assert_eq(d.saves, 0, "and nothing was saved")
end a_question_that_cannot_be_asked_stays_and_says_why

@test
an_answer_no_button_gives_is_cancel()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    d.reply = Ok(Some(99))
    w.request_quit()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(d.saves, 0, "nothing saved")
end an_answer_no_button_gives_is_cancel

@test
dont_save_goes_on_and_loses_them_because_it_was_told_to()
    val (w, d, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    d.reply = DISCARD
    choose(w, &c, "New")
    assert_eq(d.questions, 1, "asked")
    assert_eq(w.doc.items().len, 0, "a new document")
    assert(!w.doc.can_undo, "with no history")
end dont_save_goes_on_and_loses_them_because_it_was_told_to

@test
save_with_a_file_writes_it_and_then_goes_on()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()
    val file = s"${where}/a.tekton"

    w.add(Primitive.Box)
    d.answer = chosen(file)
    w.save_as()

    w.add(Primitive.Sphere)

    val text = document_text(w.doc)

    d.reply = SAVE
    choose(w, &c, "New")
    assert_eq(d.saves, 1, "the file it had needed no dialog")
    assert_eq(read_text(file).unwrap(), text, "both shapes are in the file")
    assert_eq(w.doc.items().len, 0, "and the new document is here")
    assert_eq(w.file, "", "with no file")
    remove_dir_all(where).unwrap()
end save_with_a_file_writes_it_and_then_goes_on

@test
save_with_no_file_asks_where_and_then_goes_on()
    val (w, d, quits) = workspace()
    val where = dir()
    val file = s"${where}/b"

    w.add(Primitive.Box)
    d.answer = chosen(file)
    d.reply = SAVE
    w.request_quit()
    assert_eq(d.questions, 1, "asked first")
    assert_eq(d.saves, 1, "the dialog")
    assert_eq(read_text(s"${file}.tekton").unwrap(), document_text(w.doc), "written, with the extension")
    assert_eq(quits.read(), 1, "and then it quit")
    remove_dir_all(where).unwrap()
end save_with_no_file_asks_where_and_then_goes_on

@test
cancelling_the_dialog_after_save_stops_what_was_going_to_happen()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    d.answer = DialogResult.Cancelled
    d.reply = SAVE
    w.request_quit()
    assert_eq(d.saves, 1, "the dialog was up")
    assert_eq(quits.read(), 0, "still here")
    assert_eq(w.doc.items().len, 1, "with the document")
    assert(w.doc.is_dirty(), "unsaved")
    assert_eq(w.problem.read(), "", "and cancelling is no problem")
end cancelling_the_dialog_after_save_stops_what_was_going_to_happen

@test
a_failed_dialog_after_save_stops_too_and_says_so()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    d.answer = DialogResult.Failed("no portal")
    d.reply = SAVE
    w.request_quit()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(w.problem.read(), "The file dialog failed: no portal", "said")
end a_failed_dialog_after_save_stops_too_and_says_so

@test
a_failed_save_after_the_question_stops_and_says_so_and_the_old_file_stays()
    val (w, d, quits) = workspace()
    val where = dir()
    val file = s"${where}/a.tekton"

    w.add(Primitive.Box)
    d.answer = chosen(file)
    w.save_as()

    val old = read_text(file).unwrap()

    w.add(Primitive.Sphere)
    set_permissions(where, 0o555u32).unwrap()
    d.reply = SAVE
    w.request_quit()
    set_permissions(where, 0o755u32).unwrap()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(read_text(file).unwrap(), old, "the old file")
    assert_eq(w.doc.items().len, 2, "the document")
    assert(w.doc.is_dirty(), "unsaved")
    assert(w.problem.read().starts_with("Could not save a.tekton: "), w.problem.read())
    remove_dir_all(where).unwrap()
end a_failed_save_after_the_question_stops_and_says_so_and_the_old_file_stays

@test
quit_with_nothing_unsaved_quits_and_the_question_can_refuse_it()
    val (w, d, quits) = workspace()

    w.request_quit()
    assert_eq(quits.read(), 1, "clean: straight away")
    assert_eq(d.questions, 0, "with no question")

    w.next_frame()
    w.add(Primitive.Box)
    w.request_quit()
    w.request_quit()
    assert_eq(d.questions, 1, "a window's two close events ask once")
    assert_eq(quits.read(), 1, "cancelled")
    w.request_quit()
    assert_eq(d.questions, 1, "still the same close")
    w.next_frame()
    d.reply = DISCARD
    w.request_quit()
    assert_eq(d.questions, 2, "a later close asks again")
    assert_eq(quits.read(), 2, "told to")
end quit_with_nothing_unsaved_quits_and_the_question_can_refuse_it

@test
quit_on_the_menu_asks_too()
    val (w, d, quits) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    choose(w, &c, "Quit")
    assert_eq(quits.read(), 0, "not yet")
    assert_eq(d.questions, 1, "asked")
end quit_on_the_menu_asks_too

@test
open_replaces_the_document_clears_undo_and_frames_it()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()
    val file = box_file(where)

    d.answer = chosen(file)
    choose(w, &c, "Open")
    assert_eq(d.opens, 1, "the dialog")
    assert_eq(w.file, file, "that file")
    assert_eq(w.doc.items().len, 1, "its shape")
    assert(!w.doc.can_undo, "no undo")
    assert(!w.doc.is_dirty(), "clean")

    val framed = new_camera()

    framed.frame(w.doc)
    assert_eq(w.camera.distance, framed.distance, "framed distance")
    assert_eq(w.title(), "box.tekton — Tekton", "no mark")
    assert(shows(w, &c, "palette.box"), "and the window draws it")
    remove_dir_all(where).unwrap()
end open_replaces_the_document_clears_undo_and_frames_it

@test
open_with_unsaved_changes_asks_before_the_dialog()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()

    d.answer = chosen(box_file(where))
    w.add(Primitive.Sphere)
    w.add(Primitive.Sphere)
    choose(w, &c, "Open")
    assert_eq(d.questions, 1, "asked")
    assert_eq(d.opens, 0, "and cancelled, so no dialog")
    d.reply = DISCARD
    choose(w, &c, "Open")
    assert_eq(d.opens, 1, "then")
    assert_eq(w.doc.items().len, 1, "the file's")
    remove_dir_all(where).unwrap()
end open_with_unsaved_changes_asks_before_the_dialog

@test
a_bad_file_says_its_line_and_leaves_the_document_and_its_undo_alone()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()
    val bad = s"${where}/bad.tekton"
    val good = s"${where}/good.tekton"

    write_text(bad, "tekton = 1\nnext = oops\nnodes = []\n").unwrap()
    w.add(Primitive.Box)
    d.answer = chosen(good)
    w.save_as()
    d.answer = chosen(bad)

    val was = w.doc

    choose(w, &c, "Open")
    assert(w.doc === was, "the same document")
    assert(w.doc.can_undo, "its undo")
    assert_eq(w.file, good, "its file")
    assert_eq(w.problem.read(), "Could not open bad.tekton: line 2: `next` must be a whole number", "why")
    remove_dir_all(where).unwrap()
end a_bad_file_says_its_line_and_leaves_the_document_and_its_undo_alone

@test
open_cancelled_or_failed_leaves_everything()
    val (w, d, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)
    w.doc.mark_saved()

    val was = w.doc

    d.answer = DialogResult.Cancelled
    choose(w, &c, "Open")
    assert(w.doc === was, "cancelled")
    assert_eq(w.problem.read(), "", "quietly")
    d.answer = DialogResult.Failed("no portal")
    choose(w, &c, "Open")
    assert(w.doc === was, "failed")
    assert_eq(w.problem.read(), "The file dialog failed: no portal", "said")
end open_cancelled_or_failed_leaves_everything

@test
a_bad_file_at_startup_starts_empty_and_save_cannot_overwrite_it()
    val (w, d, _) = workspace()
    val where = dir()
    val bad = s"${where}/bad.tekton"

    write_text(bad, "not a document\n").unwrap()
    assert(!w.open_path(bad), "refused")
    assert(w.problem.read().starts_with("Could not open bad.tekton: line 1: "), w.problem.read())
    assert_eq(w.doc.items().len, 0, "empty")
    assert_eq(w.file, "", "and it is not that file")

    w.add(Primitive.Box)
    d.answer = DialogResult.Cancelled
    w.save()
    assert_eq(d.saves, 1, "so Save asks where")
    assert_eq(read_text(bad).unwrap(), "not a document\n", "and the file is what it was")
    remove_dir_all(where).unwrap()
end a_bad_file_at_startup_starts_empty_and_save_cannot_overwrite_it

@test
save_goes_to_the_file_and_save_as_always_asks()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()
    val first = s"${where}/first.tekton"
    val second = s"${where}/second.tekton"

    w.add(Primitive.Box)
    d.answer = chosen(first)
    choose(w, &c, "Save")
    assert_eq(d.saves, 1, "no file yet: asks")
    assert_eq(w.file, first, "and has one")
    assert(!w.doc.is_dirty(), "clean")

    w.add(Primitive.Cone)
    choose(w, &c, "Save")
    assert_eq(d.saves, 1, "has one: does not ask")
    assert(!w.doc.is_dirty(), "clean again")
    assert_eq(read_text(first).unwrap(), document_text(w.doc), "the file has it")

    d.answer = chosen(second)
    choose(w, &c, "Save As")
    assert_eq(d.saves, 2, "always asks")
    assert_eq(w.file, second, "and moves on to it")
    remove_dir_all(where).unwrap()
end save_goes_to_the_file_and_save_as_always_asks

@test
a_failed_save_as_keeps_the_file_it_had()
    val (w, d, _) = workspace()
    val where = dir()
    val first = s"${where}/first.tekton"

    w.add(Primitive.Box)
    d.answer = chosen(first)
    w.save_as()
    w.add(Primitive.Box)
    d.answer = chosen("/no/such/directory/a.tekton")
    w.save_as()
    assert_eq(w.file, first, "still that file")
    assert(w.doc.is_dirty(), "unsaved")
    assert(w.problem.read().starts_with("Could not save a.tekton: "), w.problem.read())
    remove_dir_all(where).unwrap()
end a_failed_save_as_keeps_the_file_it_had

@test
each_shortcut_does_its_command_once_and_not_on_a_repeat()
    val (w, d, _) = workspace()

    d.answer = DialogResult.Cancelled

    assert(key(w, 'o'), "Cmd+O is a shortcut")
    assert_eq(d.opens, 1, "Open")
    assert(key(w, 'o', repeat = REPEAT), "held")
    assert_eq(d.opens, 1, "once")

    assert(key(w, 's'), "Cmd+S")
    assert_eq(d.saves, 1, "Save with no file asks")
    assert(key(w, 's', KMOD_GUI | KMOD_SHIFT), "Cmd+Shift+S")
    assert_eq(d.saves, 2, "Save As")
    assert(key(w, 's', repeat = REPEAT), "held")
    assert_eq(d.saves, 2, "once")

    w.add(Primitive.Box)
    w.doc.mark_saved()

    val was = w.doc

    assert(key(w, 'n'), "Cmd+N")
    assert(w.doc !== was, "New")
    assert(!key(w, 'n', NO_MODS), "a plain n is typing")
    assert(!key(w, 'q'), "Cmd+Q is not ours")
end each_shortcut_does_its_command_once_and_not_on_a_repeat

@test
a_shortcut_waits_for_a_field_being_typed_in()
    val (w, d, _) = workspace()

    w.typing = true
    assert(!key(w, 'o'), "the field's")
    assert_eq(d.opens, 0, "nothing")
end a_shortcut_waits_for_a_field_being_typed_in

@test
a_file_command_does_nothing_in_the_middle_of_a_drag()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    w.frame_all()

    var c = recorder()

    render(w.tree(), &c, WINDOW)

    // The middle of the box, where the viewport shows it, pressed and carried a little way and held there.
    val vx = WINDOW.w - w.width
    val vy = WINDOW.h - w.height
    val (x, y) = w.camera.project(w.doc.bounds_of(w.doc.items()[0]).center(), real(w.width), real(w.height)).unwrap()

    c.point(vx + int(x), vy + int(y), true)
    render(w.tree(), &c, WINDOW)
    c.point(vx + int(x) + 30, vy + int(y), true)
    render(w.tree(), &c, WINDOW)
    assert(w.is_editing(), "a drag is going on")

    val was = w.doc

    w.new_file()
    w.open_file()
    w.save()
    w.save_as()
    w.request_quit()
    assert(w.doc === was, "the same document")
    assert_eq(d.questions, 0, "no question")
    assert_eq(d.opens + d.saves + quits.read(), 0, "no dialog and no quit")
end a_file_command_does_nothing_in_the_middle_of_a_drag

@test
a_failed_save_as_after_the_question_stops_what_was_going_to_happen()
    val (w, d, quits) = workspace()

    w.add(Primitive.Box)
    d.answer = chosen("/no/such/directory/a.tekton")
    d.reply = SAVE
    w.request_quit()
    assert_eq(quits.read(), 0, "still here")
    assert_eq(w.file, "", "with no file")
    assert(w.problem.read().starts_with("Could not save a.tekton: "), w.problem.read())
end a_failed_save_as_after_the_question_stops_what_was_going_to_happen

// A dialog that does not answer until the test says.
private struct Held
    answer: Option[&Fn(DialogResult) -> unit]

@test
while_a_file_dialog_is_up_nothing_can_change_what_it_was_asked_about()
    val (w, _, quits) = workspace()
    var c = recorder()
    val where = dir()
    val file = box_file(where)
    val held: &Held = Held(None)

    w.ask_open = (answer, parent) -> held.answer = Some(answer)
    w.open_file()
    assert(held.answer.is_some(), "the dialog is up")
    assert(w.in_dialog.read(), "and known to be")

    c.point(100, 150, true)
    render(w.tree(), &c, WINDOW)
    c.release(100, 150)
    render(w.tree(), &c, WINDOW)
    assert_eq(w.doc.items().len, 0, "the palette is under it")
    assert(key(w, 'n'), "Cmd+N is taken")
    w.request_quit()
    assert_eq(quits.read(), 0, "the window stays")

    val answer = held.answer.unwrap()

    answer(chosen(file))
    assert(!w.in_dialog.read(), "answered")
    assert_eq(w.doc.items().len, 1, "and it is the file's")
    remove_dir_all(where).unwrap()
end while_a_file_dialog_is_up_nothing_can_change_what_it_was_asked_about

// Writes a recognisable pattern over a few kilobytes of the stack below the caller, so a closure that still
// lives in a frame that has returned would read garbage.
private scribble(depth: int, seed: int) -> int
    var junk = [0; 256]
    for i in 0..<256
        junk[i] = seed * 31 + i + depth

    if depth == 0 then junk[seed % 256] else junk[depth % 256] + scribble(depth - 1, seed + 1)

@test
a_dialog_answer_after_the_asking_frame_has_returned_still_reaches_the_document()
    val (w, _, quits) = workspace()
    val where = dir()
    val file = box_file(where)
    val held: &Held = Held(None)

    w.ask_open = (answer, parent) -> held.answer = Some(answer)
    w.open_file()
    assert(held.answer.is_some(), "the dialog is up")

    assert(scribble(24, 7) != 0, "the stack below the asking frame is overwritten")

    val answer = held.answer.unwrap()

    answer(chosen(file))
    assert(!w.in_dialog.read(), "answered")
    assert_eq(w.doc.items().len, 1, "and the file reached the document")
    assert_eq(quits.read(), 0, "without a quit")
    remove_dir_all(where).unwrap()
end a_dialog_answer_after_the_asking_frame_has_returned_still_reaches_the_document

@test
the_mark_follows_undo_back_to_what_was_saved()
    val (w, d, _) = workspace()
    var c = recorder()
    val where = dir()

    assert_eq(w.title(), "Untitled — Tekton", "new")
    w.add(Primitive.Box)
    assert_eq(w.title(), "• Untitled — Tekton", "edited")
    d.answer = chosen(s"${where}/a.tekton")
    w.save()
    assert_eq(w.title(), "a.tekton — Tekton", "saved")
    w.add(Primitive.Sphere)
    assert_eq(w.title(), "• a.tekton — Tekton", "edited again")
    w.undo()
    assert_eq(w.title(), "a.tekton — Tekton", "undone back to it")
    w.redo()
    assert_eq(w.title(), "• a.tekton — Tekton", "redone")
    render(w.tree(), &c, WINDOW)

    var marked = false

    for op in c.ops.view()
        if op.index_of("Tekton *").is_some() then marked = true

    assert(!marked, "the window's title carries the mark, not the panel")
    remove_dir_all(where).unwrap()
end the_mark_follows_undo_back_to_what_was_saved

// What the window was retitled to, in order.
private struct Titles
    given: Buf[string]
    works: bool

@test
the_window_is_retitled_once_for_each_change_of_file_or_mark()
    val (w, d, _) = workspace()
    val where = dir()
    val t: &Titles = Titles(buf(), true)

    w.retitle = title ->
        t.given.push(title)
        t.works

    w.next_frame()
    w.next_frame()
    assert_eq(t.given.len(), 1, "once for the first frame, not again for an unchanged one")
    assert_eq(t.given[0], "Untitled — Tekton", "with no file")
    w.add(Primitive.Box)
    w.next_frame()
    assert_eq(t.given[1], "• Untitled — Tekton", "unsaved")
    d.answer = chosen(s"${where}/part.tekton")
    w.save()
    w.next_frame()
    w.next_frame()
    assert_eq(t.given.len(), 3, "saved: once")
    assert_eq(t.given[2], "part.tekton — Tekton", "named, clean")
    remove_dir_all(where).unwrap()
end the_window_is_retitled_once_for_each_change_of_file_or_mark

@test
a_title_the_window_did_not_take_is_tried_again()
    val (w, _, _) = workspace()
    val t: &Titles = Titles(buf(), false)

    w.retitle = title ->
        t.given.push(title)
        t.works

    w.next_frame()
    w.next_frame()
    assert_eq(t.given.len(), 2, "no window yet: asked again next frame")
    t.works = true
    w.next_frame()
    w.next_frame()
    assert_eq(t.given.len(), 3, "and once taken, left alone")
end a_title_the_window_did_not_take_is_tried_again

@test
the_title_names_the_file_and_marks_what_is_unsaved()
    assert_eq(window_title("", false), "Untitled — Tekton", "no file")
    assert_eq(window_title("", true), "• Untitled — Tekton", "no file, unsaved")
    assert_eq(window_title("/a/b/part.tekton", false), "part.tekton — Tekton", "only the name")
    assert_eq(window_title("/a/b/part.tekton", true), "• part.tekton — Tekton", "named, unsaved")
end the_title_names_the_file_and_marks_what_is_unsaved

@test
the_question_saves_on_return_and_cancels_on_escape()
    val all = question_buttons()

    assert_eq(all.len(), 3, "three buttons")
    assert_eq(all[0].text, "Save", "first")
    assert_eq(all[1].text, "Don't Save", "second")
    assert_eq(all[2].text, "Cancel", "third")
    assert(all[0].on_return && !all[0].on_escape, "Return is Save")
    assert(!all[1].on_return && !all[1].on_escape, "Don't Save has no key")
    assert(all[2].on_escape && !all[2].on_return, "Escape is Cancel")

    for b in all.view()
        unsaved_answer(Ok(Some(b.id))) match
            SaveFirst -> assert_eq(b.text, "Save", "Save saves")
            Discard -> assert_eq(b.text, "Don't Save", "Don't Save discards")
            Stay(why) ->
                assert_eq(b.text, "Cancel", "Cancel stays")
                assert_eq(why, "", "with nothing to say")
end the_question_saves_on_return_and_cancels_on_escape

@test
what_each_answer_to_the_question_means()
    assert(matches_save(unsaved_answer(SAVE)), "Save")
    assert(matches_discard(unsaved_answer(DISCARD)), "Don't Save")
    assert_eq(stay_of(unsaved_answer(Ok(Some(CANCEL_ANSWER)))), Some(""), "Cancel")
    assert_eq(stay_of(unsaved_answer(Ok(None))), Some(""), "closed")
    assert_eq(stay_of(unsaved_answer(Ok(Some(7)))), Some(""), "no button of ours")
    assert_eq(stay_of(unsaved_answer(Err("gone"))), Some("Could not ask about the unsaved changes: gone"), "failed")
end what_each_answer_to_the_question_means

private matches_save(u: Unsaved) -> bool =
    u match
        SaveFirst -> true
        _ -> false

private matches_discard(u: Unsaved) -> bool =
    u match
        Discard -> true
        _ -> false

private stay_of(u: Unsaved) -> Option[string] =
    u match
        Stay(why) -> Some(why)
        _ -> None

// What each dialog and the question were given as their window.
private struct Parents
    window: &Window
    seen: Buf[bool]

@test
every_dialog_and_the_question_belong_to_the_window()
    set_hint(HINT_VIDEO_DRIVER, "dummy")
    assert(init(INIT_VIDEO), "SDL came up headless")

    val (w, d, _) = workspace()
    val p: &Parents = Parents(create_window("parent", 64, 64, WINDOW_HIDDEN).unwrap(), buf())

    w.parent = () -> Some(p.window)
    w.ask_open = (answer, parent) ->
        p.seen.push(parent.is_some() && parent.unwrap() === p.window)
        answer(DialogResult.Cancelled)
    w.ask_save = (answer, parent) ->
        p.seen.push(parent.is_some() && parent.unwrap() === p.window)
        answer(DialogResult.Cancelled)
    w.ask_export_stl = (answer, parent) ->
        p.seen.push(parent.is_some() && parent.unwrap() === p.window)
        answer(DialogResult.Cancelled)
    w.ask_export_3mf = (answer, parent) ->
        p.seen.push(parent.is_some() && parent.unwrap() === p.window)
        answer(DialogResult.Cancelled)
    w.ask_changes = (title, parent) ->
        p.seen.push(parent.is_some() && parent.unwrap() === p.window)
        Ok(Some(CANCEL_ANSWER))

    w.open_file()
    w.save_as()
    w.add(Primitive.Box)
    w.export_stl_file()
    w.export_3mf_file()
    w.new_file()
    assert_eq(p.seen.len(), 5, "open, save as, both exports and the question")

    for one in p.seen.view() do assert(one, "each given the window")

    w.parent = () -> None
    w.open_file()
    assert_eq(p.seen.len(), 6, "asked again")
    assert(!p.seen[5], "and with no window, none")
    assert_eq(d.opens, 0, "the test's own dialogs answered, not the helper's")
end every_dialog_and_the_question_belong_to_the_window

@test
a_new_document_goes_on_from_the_old_ones_revisions()
    val (w, _, _) = workspace()

    w.add(Primitive.Box)

    val old = w.doc.mesh_of(w.doc.items()[0]).revision

    w.doc.mark_saved()
    w.new_file()
    w.add(Primitive.Box)
    assert(w.doc.mesh_of(w.doc.items()[0]).revision > old, "the renderer cannot take the new box for the old one")
end a_new_document_goes_on_from_the_old_ones_revisions

@test
what_was_being_typed_about_the_old_document_does_not_reach_the_new_one()
    val (w, _, _) = workspace()
    var c = recorder()

    w.add(Primitive.Box)

    val id = w.doc.selected.unwrap()

    render(w.tree(), &c, WINDOW)
    w.number_fields()[0].was_mine = true
    w.number_fields()[0].text.set("77")
    c.take_focus(FIRST_FIELD_ID)
    w.doc.mark_saved()
    w.new_file()
    assert_eq(id, 1, "the first box")
    w.add(Primitive.Box)
    render(w.tree(), &c, WINDOW)
    render(w.tree(), &c, WINDOW)
    assert(c.focus() != FIRST_FIELD_ID, "the keyboard came back")
    assert(w.doc.find(w.doc.selected.unwrap()).unwrap().transform.translation.x != 77.0, "not what was typed")
    assert_eq(w.problem.read(), "", "and no complaint about it")
end what_was_being_typed_about_the_old_document_does_not_reach_the_new_one
