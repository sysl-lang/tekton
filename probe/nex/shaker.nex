// A printable shaker bottle: a lofted, waisted body hollowed to a thin wall, graduated every 100 ml,
// with an external thread on its neck, and a screw lid with an internal thread, a clearance and a
// pattern of holes in its top.

import tekton.*

// The parameters, as module-level `var`s a host may set before calling `build`, each with the
// range the inspector's slider gets in `sliders`.
var height = 150mm
var radius = 34mm
var waist = 0.82
var wall = 1.6mm
var pitch = 3mm
var clearance = 0.35mm

val neck_r = 16mm
val neck_h = 14mm
val lid_wall = 2mm
val hole_d = 2.5mm

def sliders(): [Slider] = [
  slider_mm("height", height, 80mm, 220mm),
  slider_mm("radius", radius, 20mm, 50mm),
  slider("waist ratio", waist, 0.5, 1.0),
  slider_mm("wall", wall, 0.8mm, 3mm),
  slider_mm("thread pitch", pitch, 1.5mm, 4mm),
  slider_mm("clearance", clearance, 0.1mm, 0.8mm)]

// The number of 100 ml marks. Natural: `1..floor(x)`; `floor` answers a real, which a range refuses.
def marks_count(): integer = to_integer(floor(strip(volume_below(height)) / 100.0))

// The body's outer radius at each section height, bottom to top: base, waist, shoulder, top.
def section_z(): [real<mm>] = [0mm, 0.45 * height, 0.8 * height, height]
def section_r(): [real<mm>] = [radius, waist * radius, 0.97 * radius, neck_r + 4mm]

// The inside's volume up to height `z`, from the sections taken as straight between each pair: the
// frustum of each slice, less the wall.
def volume_below(z: real<mm>): real<cm^3> =
  val zs = section_z()
  val rs = section_r() - wall
  var v = 0.0<cm^3>
  for k in 1..<length(zs)
    val z0 = zs[k]
    val z1 = min(zs[k + 1], z)
    if z1 > z0 then
      val r0 = rs[k]
      val r1 = rs[k] + (rs[k + 1] - rs[k]) * (z1 - z0) / (zs[k + 1] - zs[k])
      v += pi * (z1 - z0) * (r0^2 + r0 * r1 + r1^2) / 3
  v

// The height at which the inside holds `v`, by bisection.
def height_for(v: real<cm^3>): real<mm> =
  var lo = wall
  var hi = height
  for iter in 1..50
    val mid = (lo + hi) / 2
    if volume_below(mid) < v then lo = mid else hi = mid
  (lo + hi) / 2

def body(): Solid =
  val zs = section_z()
  val rs = section_r()
  // The waist is an ellipse, flattened for the grip; the other sections are round.
  val sections = [Circle(rs[1]), Ellipse(rs[2], 0.9 * rs[2]), Circle(rs[3]), Circle(rs[4])]
  val outer = loft(sections, zs)
  val hollow = shell(outer, wall, open = [Top])
  val neck = translate(cut(cylinder(neck_r, neck_h), cylinder(neck_r - wall, neck_h)), z = height)
  val major = 2 * neck_r + 2 * 0.6134 * pitch
  val ridge = translate(thread(major, pitch, neck_h - 2mm), z = height + 1mm)
  // A raised ring on the outside at every 100 ml.
  val marks = map(1..marks_count(), k ->
    val z = height_for(k * 100.0<cm^3>)
    translate(cylinder(radius + 0.6mm, 0.6mm), z = z))
  named(union_all([hollow, neck, ridge, union_all(marks)]), "bottle")

def lid(): Solid =
  val major = 2 * neck_r + 2 * 0.6134 * pitch
  val inner_r = major / 2 + clearance
  val outer_r = inner_r + lid_wall
  val skirt = neck_h
  val cap = cut(cylinder(outer_r, skirt + lid_wall), cylinder(inner_r, skirt))
  val groove = thread(major, pitch, skirt - 1mm, kind = Internal, clearance = clearance)
  // Holes: one in the middle, six around it, twelve outside them.
  val hole = translate(cylinder(hole_d / 2, lid_wall + 2mm), z = skirt - 1mm)
  val holes = [hole, polar(hole, 6, 0.3 * inner_r), polar(hole, 12, 0.62 * inner_r, phase = 15deg)]
  val knurl = polar(cube(1.2mm, 1.2mm, skirt), 36, outer_r)
  named(union(cut_all(cut(cap, groove), holes), knurl), "lid")

def build(): [Solid] =
  check(sliders())
  [body(), translate(lid(), x = 3 * radius)]

def main() =
  print("parameters:")
  show(sliders())
  val parts = build()
  val full = volume_below(height)
  print(f"capacity ${strip(full)}%.0f ml")
  for k in 1..marks_count()
    print(f"  ${k * 100} ml mark at ${strip(height_for(k * 100.0<cm^3>))}%.1f mm")
  val (lo, hi) = bbox(parts[1])
  print(s"bottle box $lo .. $hi")
  print(s"bottle tree: ${nodes(parts[1])} nodes; lid tree: ${nodes(parts[2])} nodes")
  describe(parts[2], depth = 2)
  // Round the bottle's base: the circular edges at the bottom.
  val base = edges(parts[1]).filter(e -> is_circular(e) and e.z < 1mm)
  val rounded = fillet(parts[1], base, 3mm)
  describe(rounded, depth = 1)
